; RUN: llc -march=klausscpu -verify-machineinstrs -O0 < %s | FileCheck %s --check-prefix=O0
; RUN: llc -march=klausscpu -verify-machineinstrs -O2 < %s | FileCheck %s
;
; Soft float: fabs, fneg and copysign only touch the sign bit of the integer
; representation, so the type legalizer softens them to bit operations
; (BCLR / ANDV, BTGL / XORI, a masked OR), never a libcall, at every level
; and for every width (f16 in the low 16 bits, fp128 in R12:R11).  Clang
; turns a hosted program's fabs/fabsf/copysign/-x into these intrinsics; only
; code built -ffreestanding / -fno-builtin calls libm's fabs.

define half @fabs_f16(half %x) nounwind {
; O0-LABEL: fabs_f16:
; O0:       # %bb.0:
; O0-NEXT:    # kill: def $r12 killed $r0
; O0-NEXT:    andv r12, r0, 32767
; O0-NEXT:    ret
;
; CHECK-LABEL: fabs_f16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    andv r12, r0, 32767
; CHECK-NEXT:    ret
  %r = call half @llvm.fabs.f16(half %x)
  ret half %r
}

