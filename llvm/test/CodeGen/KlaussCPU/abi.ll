; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=klausscpu -O1 -verify-machineinstrs < %s | FileCheck %s

; The calling convention (ABI.md).  i32 arguments and results carry signext
; (clang marks every i32, signed or not, as RV64 does), so the consumer relies
; on the upper half: no SEXTW for a parameter or a call result, and an
; unsigned compare of two i32 is a full-width FBR.  The backend's own library
; calls follow the same rule (shouldSignExtendTypeInLibCall).  Aggregates of
; up to 16 bytes come in one or two GPRs ([2 x i64], possibly split between
; R3 and the stack) and go back in R12/R11.  Only a variadic call reserves a
; call frame without stack arguments (the 32-byte home area of R0-R3), and a
; call clobbers only the registers outside its preserved mask.

declare signext i32 @ext_i32(i32 signext)
declare void @take_pair([2 x i64])
declare void @take_pair_late(i64, i64, i64, [2 x i64])
declare i64 @vararg(i64, ...)

define i64 @sext_param(i32 signext %a) nounwind {
; CHECK-LABEL: sext_param:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    copy r12, r0
; CHECK-NEXT:    leaveret
  %r = sext i32 %a to i64
  ret i64 %r
}

define i64 @sext_result(i32 signext %a) nounwind {
; CHECK-LABEL: sext_result:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    callrel ext_i32
; CHECK-NEXT:    leaveret
  %c = call signext i32 @ext_i32(i32 signext %a)
  %r = sext i32 %c to i64
  ret i64 %r
}

; The argument must be sign-extended for the callee: ADDIW, not ADDI.
define signext i32 @sext_arg(i32 signext %a) nounwind {
; CHECK-LABEL: sext_arg:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    addiw r0, r0, 1
; CHECK-NEXT:    callrel ext_i32
; CHECK-NEXT:    leaveret
  %b = add i32 %a, 1
  %c = call signext i32 @ext_i32(i32 signext %b)
  ret i32 %c
}

define i64 @ult32(i32 signext %a, i32 signext %b) nounwind {
; CHECK-LABEL: ult32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    setr r12, 1
; CHECK-NEXT:    fbr r0, r1, 3, .LBB3_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    setr r12, 2
; CHECK-NEXT:  .LBB3_2:
; CHECK-NEXT:    leaveret
  %c = icmp ult i32 %a, %b
  %r = select i1 %c, i64 1, i64 2
  ret i64 %r
}

; A libcall's i32 argument is sign-extended, also where the default would
; zero-extend it (__powidf2's int exponent).
define double @libcall_i32(double %d, i64 %x) nounwind {
; CHECK-LABEL: libcall_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    sextw r1, r1
; CHECK-NEXT:    callrel __powidf2
; CHECK-NEXT:    leaveret
  %t = trunc i64 %x to i32
  %r = call double @llvm.powi.f64.i32(double %d, i32 %t)
  ret double %r
}

; A softened f16 argument is zero-extended: compiler-rt's half-precision
; functions take and return a uint16_t (clang has no _Float16 here).  The
; caller does not rely on the extension of the result.
define float @libcall_f16_arg(i64 %x) nounwind {
; CHECK-LABEL: libcall_f16_arg:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    zexth r0, r0
; CHECK-NEXT:    callrel __extendhfsf2
; CHECK-NEXT:    leaveret
  %t = trunc i64 %x to i16
  %h = bitcast i16 %t to half
  %f = fpext half %h to float
  ret float %f
}

define i64 @libcall_f16_ret(float %f) nounwind {
; CHECK-LABEL: libcall_f16_ret:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    callrel __truncsfhf2
; CHECK-NEXT:    zexth r12, r12
; CHECK-NEXT:    leaveret
  %h = fptrunc float %f to half
  %i = bitcast half %h to i16
  %z = zext i16 %i to i64
  ret i64 %z
}

; A softened f32 is passed in the low half, not extended.
define double @libcall_f32_arg(i64 %x) nounwind {
; CHECK-LABEL: libcall_f32_arg:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    callrel __extendsfdf2
; CHECK-NEXT:    leaveret
  %t = trunc i64 %x to i32
  %f = bitcast i32 %t to float
  %d = fpext float %f to double
  ret double %d
}

; A 9-16 byte aggregate in two registers, and split between R3 and the
; first stack slot when only R3 is left.
define void @pass_pair(i64 %a, i64 %b) nounwind {
; CHECK-LABEL: pass_pair:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 2
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r1
; CHECK-NEXT:    callrel take_pair
; CHECK-NEXT:    getsp r12
; CHECK-NEXT:    setr r0, 7
; CHECK-NEXT:    setr r1, 8
; CHECK-NEXT:    setr r2, 9
; CHECK-NEXT:    setr r3, 10
; CHECK-NEXT:    stidx64 r4, r12, 0
; CHECK-NEXT:    callrel take_pair_late
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
  %p0 = insertvalue [2 x i64] poison, i64 %a, 0
  %p1 = insertvalue [2 x i64] %p0, i64 %b, 1
  call void @take_pair([2 x i64] %p1)
  %q0 = insertvalue [2 x i64] poison, i64 10, 0
  %q1 = insertvalue [2 x i64] %q0, i64 %b, 1
  call void @take_pair_late(i64 7, i64 8, i64 9, [2 x i64] %q1)
  ret void
}

define [2 x i64] @ret_pair(i64 %a, i64 %b) nounwind {
; CHECK-LABEL: ret_pair:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    copy r12, r0
; CHECK-NEXT:    copy r11, r1
; CHECK-NEXT:    leaveret
  %p0 = insertvalue [2 x i64] poison, i64 %a, 0
  %p1 = insertvalue [2 x i64] %p0, i64 %b, 1
  ret [2 x i64] %p1
}

; The callee of a split pair finds the second half above the return address.
define i64 @recv_pair_late(i64 %a, i64 %b, i64 %c, [2 x i64] %p) nounwind {
; CHECK-LABEL: recv_pair_late:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx64 r12, r15, 16
; CHECK-NEXT:    addr r12, r3, r12
; CHECK-NEXT:    leaveret
  %x = extractvalue [2 x i64] %p, 0
  %y = extractvalue [2 x i64] %p, 1
  %r = add i64 %x, %y
  ret i64 %r
}

; A variadic call reserves the home area (enter 4: 32 bytes) even with no
; stack argument; its fifth argument lands above it.
define i64 @call_vararg() nounwind {
; CHECK-LABEL: call_vararg:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 5
; CHECK-NEXT:    setr r0, 1
; CHECK-NEXT:    setr r1, 2
; CHECK-NEXT:    callrel vararg
; CHECK-NEXT:    copy r0, r12
; CHECK-NEXT:    getsp r12
; CHECK-NEXT:    setr r14, 5
; CHECK-NEXT:    setr r1, 2
; CHECK-NEXT:    setr r2, 3
; CHECK-NEXT:    setr r3, 4
; CHECK-NEXT:    stidx64 r14, r12, 32
; CHECK-NEXT:    callrel vararg
; CHECK-NEXT:    leaveret
  %a = call i64 (i64, ...) @vararg(i64 1, i64 2)
  %b = call i64 (i64, ...) @vararg(i64 %a, i64 2, i64 3, i64 4, i64 5)
  ret i64 %b
}

; A value live across a call stays in a caller-saved register only if the
; call preserves it: R4-R7 (and R15) survive, nothing else.
define i64 @live_across(i64 %a) nounwind {
; CHECK-LABEL: live_across:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 1
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r0
; CHECK-NEXT:    sextw r0, r0
; CHECK-NEXT:    callrel ext_i32
; CHECK-NEXT:    addr r12, r12, r4
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
  %t = trunc i64 %a to i32
  %c = call signext i32 @ext_i32(i32 signext %t)
  %s = sext i32 %c to i64
  %r = add i64 %s, %a
  ret i64 %r
}
