; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=klausscpu -verify-machineinstrs -O1 < %s | FileCheck %s
; RUN: llc -mtriple=klausscpu -verify-machineinstrs -O1 \
; RUN:   -klausscpu-tail-calls=false < %s | FileCheck %s --check-prefix=NOTAIL
; RUN: llc -mtriple=klausscpu -verify-machineinstrs -O1 \
; RUN:   -klausscpu-tail-call-dup-ret < %s | FileCheck %s --check-prefix=DUPRET
;
; Sibling calls whose arguments are all in registers are tail calls: the
; epilogue, then a jump (`tail`, the short jump with a short call's fixup;
; JMPR) instead of CALL ... LEAVERET.  The
; callee returns straight to the caller's caller.  Not for a variadic callee
; (its home area), stack, byval or sret arguments, or with
; "disable-tail-calls".

declare i64 @g(i64)
declare i64 @g5(i64, i64, i64, i64, i64)
declare i64 @gv(i64, ...)
declare void @gs(ptr sret([4 x i64]))
declare i64 @gb(ptr byval([4 x i64]))

; No frame left at all: the jump is the whole call.
define i64 @frameless(i64 %a) nounwind {
; CHECK-LABEL: frameless:
; CHECK:       # %bb.0:
; CHECK-NEXT:    incr r0, r0
; CHECK-NEXT:    tail g
;
; NOTAIL-LABEL: frameless:
; NOTAIL:       # %bb.0:
; NOTAIL-NEXT:    enter 0
; NOTAIL-NEXT:    incr r0, r0
; NOTAIL-NEXT:    callrel g
; NOTAIL-NEXT:    leaveret
;
; DUPRET-LABEL: frameless:
; DUPRET:       # %bb.0:
; DUPRET-NEXT:    incr r0, r0
; DUPRET-NEXT:    tail g
  %b = add i64 %a, 1
  %r = tail call i64 @g(i64 %b)
  ret i64 %r
}

; LEAVE after the callee-saved reload, then the jump.
define i64 @framed(i64 %a, i64 %b) nounwind {
; CHECK-LABEL: framed:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 1
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r1
; CHECK-NEXT:    callrel g
; CHECK-NEXT:    addr r0, r12, r4
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leave
; CHECK-NEXT:    tail g
;
; NOTAIL-LABEL: framed:
; NOTAIL:       # %bb.0:
; NOTAIL-NEXT:    enter 1
; NOTAIL-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; NOTAIL-NEXT:    copy r4, r1
; NOTAIL-NEXT:    callrel g
; NOTAIL-NEXT:    addr r0, r12, r4
; NOTAIL-NEXT:    callrel g
; NOTAIL-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; NOTAIL-NEXT:    leaveret
;
; DUPRET-LABEL: framed:
; DUPRET:       # %bb.0:
; DUPRET-NEXT:    enter 1
; DUPRET-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; DUPRET-NEXT:    copy r4, r1
; DUPRET-NEXT:    callrel g
; DUPRET-NEXT:    addr r0, r12, r4
; DUPRET-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; DUPRET-NEXT:    leave
; DUPRET-NEXT:    tail g
  %x = call i64 @g(i64 %a)
  %y = add i64 %x, %b
  %r = tail call i64 @g(i64 %y)
  ret i64 %r
}

; With -klausscpu-tail-call-dup-ret, CodeGenPrepare duplicates the return so
; that the call is in tail position (mayBeEmittedAsTailCall); by default the
; return stays shared.
define i64 @dup_ret(ptr %p) nounwind {
; CHECK-LABEL: dup_ret:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    fbri r0, 0, 0, .LBB2_1
; CHECK-NEXT:  # %bb.2: # %call
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx64 r0, r0, 0
; CHECK-NEXT:    callrel g
; CHECK-NEXT:    leaveret
; CHECK-NEXT:  .LBB2_1:
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    ret
;
; NOTAIL-LABEL: dup_ret:
; NOTAIL:       # %bb.0: # %entry
; NOTAIL-NEXT:    fbri r0, 0, 0, .LBB2_1
; NOTAIL-NEXT:  # %bb.2: # %call
; NOTAIL-NEXT:    enter 0
; NOTAIL-NEXT:    ldidx64 r0, r0, 0
; NOTAIL-NEXT:    callrel g
; NOTAIL-NEXT:    leaveret
; NOTAIL-NEXT:  .LBB2_1:
; NOTAIL-NEXT:    setr r12, 0
; NOTAIL-NEXT:    ret
;
; DUPRET-LABEL: dup_ret:
; DUPRET:       # %bb.0: # %entry
; DUPRET-NEXT:    fbri r0, 0, 0, .LBB2_1
; DUPRET-NEXT:  # %bb.2: # %call
; DUPRET-NEXT:    ldidx64 r0, r0, 0
; DUPRET-NEXT:    tail g
; DUPRET-NEXT:  .LBB2_1: # %ret
; DUPRET-NEXT:    setr r12, 0
; DUPRET-NEXT:    ret
entry:
  %c = icmp eq ptr %p, null
  br i1 %c, label %ret, label %call

call:
  %v = load i64, ptr %p
  %r = tail call i64 @g(i64 %v)
  br label %ret

ret:
  %x = phi i64 [ %r, %call ], [ 0, %entry ]
  ret i64 %x
}

; The function pointer lives in a callee-saved register across the first
; call, but the epilogue reloads those: the jump takes it from another one.
define i64 @indirect(ptr %fp, i64 %a) nounwind {
; CHECK-LABEL: indirect:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 1
; CHECK-NEXT:    stidx64 r0, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    copy r0, r1
; CHECK-NEXT:    callrel g
; CHECK-NEXT:    copy r0, r12
; CHECK-NEXT:    ldidx64 r12, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leave
; CHECK-NEXT:    jmpr r12
;
; NOTAIL-LABEL: indirect:
; NOTAIL:       # %bb.0:
; NOTAIL-NEXT:    enter 1
; NOTAIL-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; NOTAIL-NEXT:    copy r4, r0
; NOTAIL-NEXT:    copy r0, r1
; NOTAIL-NEXT:    callrel g
; NOTAIL-NEXT:    copy r0, r12
; NOTAIL-NEXT:    callr r4
; NOTAIL-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; NOTAIL-NEXT:    leaveret
;
; DUPRET-LABEL: indirect:
; DUPRET:       # %bb.0:
; DUPRET-NEXT:    enter 1
; DUPRET-NEXT:    stidx64 r0, r15, -8 # 8-byte Folded Spill
; DUPRET-NEXT:    copy r0, r1
; DUPRET-NEXT:    callrel g
; DUPRET-NEXT:    copy r0, r12
; DUPRET-NEXT:    ldidx64 r12, r15, -8 # 8-byte Folded Reload
; DUPRET-NEXT:    leave
; DUPRET-NEXT:    jmpr r12
  %x = call i64 @g(i64 %a)
  %r = tail call i64 %fp(i64 %x)
  ret i64 %r
}

; GlobalOpt makes an internal function fastcc; it is lowered as the C
; convention, so it is a tail call all the same.
define internal fastcc i64 @fast(i64 %a) nounwind {
; CHECK-LABEL: fast:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mulr r12, r0, r0
; CHECK-NEXT:    ret
;
; NOTAIL-LABEL: fast:
; NOTAIL:       # %bb.0:
; NOTAIL-NEXT:    mulr r12, r0, r0
; NOTAIL-NEXT:    ret
;
; DUPRET-LABEL: fast:
; DUPRET:       # %bb.0:
; DUPRET-NEXT:    mulr r12, r0, r0
; DUPRET-NEXT:    ret
  %r = mul i64 %a, %a
  ret i64 %r
}

define i64 @to_fastcc(i64 %a) nounwind {
; CHECK-LABEL: to_fastcc:
; CHECK:       # %bb.0:
; CHECK-NEXT:    incr r0, r0
; CHECK-NEXT:    tail fast
;
; NOTAIL-LABEL: to_fastcc:
; NOTAIL:       # %bb.0:
; NOTAIL-NEXT:    enter 0
; NOTAIL-NEXT:    incr r0, r0
; NOTAIL-NEXT:    callrel fast
; NOTAIL-NEXT:    leaveret
;
; DUPRET-LABEL: to_fastcc:
; DUPRET:       # %bb.0:
; DUPRET-NEXT:    incr r0, r0
; DUPRET-NEXT:    tail fast
  %b = add i64 %a, 1
  %r = tail call fastcc i64 @fast(i64 %b)
  ret i64 %r
}

