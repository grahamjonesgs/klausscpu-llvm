; Thread-local storage: every TLS model is local exec (static executables),
; TP (`mfsr rd, tp`) + %tprel(sym) (R_KLAUSSCPU_TPREL32).  The add folds into
; an indexed load / store, a constant offset into the variable joins
; %tprel, and the TP read (side-effect free) is shared.

@a = thread_local global i32 42, align 4
@b = thread_local global [100 x i64] zeroinitializer, align 8
@e = external thread_local global i32, align 4
@ie = external thread_local(initialexec) global i64, align 8
@ld = internal thread_local(localdynamic) global i16 0, align 2
@s8 = thread_local global i8 0, align 1
@al64 = thread_local global { i64, i32 } { i64 1, i32 2 }, align 64

define i32 @load_a() {
; CHECK-LABEL: load_a:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mfsr r12, tp
; CHECK-NEXT:    ldidx32 r12, r12, %tprel(a)
; CHECK-NEXT:    ret
;
; O0-LABEL: load_a:
; O0:       # %bb.0:
; O0-NEXT:    mfsr r12, tp
; O0-NEXT:    ldidx32 r12, r12, %tprel(a)
; O0-NEXT:    ret
  %p = call ptr @llvm.threadlocal.address.p0(ptr @a)
  %v = load i32, ptr %p
  ret i32 %v
}

