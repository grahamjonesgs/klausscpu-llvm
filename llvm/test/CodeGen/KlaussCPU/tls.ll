; TP is read once for the loop, outside it.
define i64 @sum_b() {
; CHECK-LABEL: sum_b:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mfsr r12, tp
; CHECK-NEXT:    setr r13, 0
; CHECK-NEXT:    addi r14, r12, %tprel(b)
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    setr r10, 800
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB10_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldidx64r r11, r14, r13
; CHECK-NEXT:    addi r13, r13, 8
; CHECK-NEXT:    addr r12, r12, r11
; CHECK-NEXT:    fbr r13, r10, 8, .LBB10_1
; CHECK-NEXT:  # %bb.2: # %done
; CHECK-NEXT:    ret
;
; O0-LABEL: sum_b:
; O0:       # %bb.0:
; O0-NEXT:    enter 4
; O0-NEXT:    .cfi_def_cfa r15, 16
; O0-NEXT:    .cfi_offset r15, -16
; O0-NEXT:    mfsr r12, tp
; O0-NEXT:    addi r12, r12, %tprel(b)
; O0-NEXT:    stidx64 r12, r15, -24 # 8-byte Folded Spill
; O0-NEXT:    setr r12, 0
; O0-NEXT:    copy r14, r12
; O0-NEXT:    stidx64 r14, r15, -16 # 8-byte Folded Spill
; O0-NEXT:    stidx64 r12, r15, -8 # 8-byte Folded Spill
; O0-NEXT:    jmprel .LBB10_1
; O0-NEXT:  .LBB10_1: # %loop
; O0-NEXT:    # =>This Inner Loop Header: Depth=1
; O0-NEXT:    ldidx64 r12, r15, -8 # 8-byte Folded Reload
; O0-NEXT:    ldidx64 r14, r15, -16 # 8-byte Folded Reload
; O0-NEXT:    ldidx64 r13, r15, -24 # 8-byte Folded Reload
; O0-NEXT:    shlv r11, r14, 3
; O0-NEXT:    ldidx64r r13, r13, r11
; O0-NEXT:    addr r12, r12, r13
; O0-NEXT:    stidx64 r12, r15, -32 # 8-byte Folded Spill
; O0-NEXT:    incr r14, r14
; O0-NEXT:    stidx64 r14, r15, -16 # 8-byte Folded Spill
; O0-NEXT:    stidx64 r12, r15, -8 # 8-byte Folded Spill
; O0-NEXT:    fbrv r14, 100, 8, .LBB10_1
; O0-NEXT:    jmprel .LBB10_2
; O0-NEXT:  .LBB10_2: # %done
; O0-NEXT:    ldidx64 r12, r15, -32 # 8-byte Folded Reload
; O0-NEXT:    leaveret
  %p = call ptr @llvm.threadlocal.address.p0(ptr @b)
  br label %loop
loop:
  %i = phi i64 [ 0, %0 ], [ %i1, %loop ]
  %s = phi i64 [ 0, %0 ], [ %s1, %loop ]
  %q = getelementptr i64, ptr %p, i64 %i
  %v = load i64, ptr %q
  %s1 = add i64 %s, %v
  %i1 = add i64 %i, 1
  %c = icmp eq i64 %i1, 100
  br i1 %c, label %done, label %loop
done:
  ret i64 %s1
}

declare ptr @llvm.threadlocal.address.p0(ptr)

