; One GOT load for both accesses (MachineCSE).
define i32 @cse(i32 %x) nounwind {
; PIC-LABEL: cse:
; PIC:       # %bb.0:
; PIC-NEXT:    leapc r12, %gotpcrel(ext)
; PIC-NEXT:    ldidx64 r14, r12, 0
; PIC-NEXT:    memget32 r12, r14
; PIC-NEXT:    memset32 r0, r14
; PIC-NEXT:    addr r12, r12, r0
; PIC-NEXT:    ret
;
; PIC-O0-LABEL: cse:
; PIC-O0:       # %bb.0:
; PIC-O0-NEXT:    # kill: def $r12 killed $r0
; PIC-O0-NEXT:    leapc r12, %gotpcrel(ext)
; PIC-O0-NEXT:    ldidx64 r14, r12, 0
; PIC-O0-NEXT:    memget32 r12, r14
; PIC-O0-NEXT:    memset32 r0, r14
; PIC-O0-NEXT:    addr r12, r12, r0
; PIC-O0-NEXT:    ret
;
; BARE-LABEL: cse:
; BARE:       # %bb.0:
; BARE-NEXT:    leapc r14, ext
; BARE-NEXT:    memget32 r12, r14
; BARE-NEXT:    memset32 r0, r14
; BARE-NEXT:    addr r12, r12, r0
; BARE-NEXT:    ret
;
; STATIC-LABEL: cse:
; STATIC:       # %bb.0:
; STATIC-NEXT:    setru r14, ext
; STATIC-NEXT:    memget32 r12, r14
; STATIC-NEXT:    memset32 r0, r14
; STATIC-NEXT:    addr r12, r12, r0
; STATIC-NEXT:    ret
