; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=klausscpu -O1 -verify-machineinstrs < %s | FileCheck %s
; RUN: llc -mtriple=klausscpu -O1 -verify-machineinstrs \
; RUN:   -klausscpu-opt-extensions=false < %s | FileCheck %s --check-prefix=NOOPT

; Pointer chase over a u32 index loaded as a u64 (perf_baseline's ptr_chase):
; the loaded index is zero-extended for the sum, and the PHI that carries it
; to the next iteration was zero-extended again at the top of the loop.
; KlaussCPUOptExtensions makes the PHI carry the extended value, so the loop
; has one ZEXTW.

define i64 @chase(ptr %b) {
; CHECK-LABEL: chase:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    setr r14, 200000
; CHECK-NEXT:    setr r13, 0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    shlv r13, r13, 3
; CHECK-NEXT:    decr r14, r14
; CHECK-NEXT:    ldidx64r r13, r0, r13
; CHECK-NEXT:    zextw r13, r13
; CHECK-NEXT:    addr r12, r12, r13
; CHECK-NEXT:    cmprvw r14, 0
; CHECK-NEXT:    jmpnerel .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
;
; NOOPT-LABEL: chase:
; NOOPT:       # %bb.0: # %entry
; NOOPT-NEXT:    setr r12, 0
; NOOPT-NEXT:    setr r14, 200000
; NOOPT-NEXT:    setr r13, 0
; NOOPT-NEXT:    .p2align 4
; NOOPT-NEXT:  .LBB0_1: # %loop
; NOOPT-NEXT:    # =>This Inner Loop Header: Depth=1
; NOOPT-NEXT:    zextw r13, r13
; NOOPT-NEXT:    decr r14, r14
; NOOPT-NEXT:    shlv r13, r13, 3
; NOOPT-NEXT:    ldidx64r r13, r0, r13
; NOOPT-NEXT:    zextw r11, r13
; NOOPT-NEXT:    addr r12, r12, r11
; NOOPT-NEXT:    cmprvw r14, 0
; NOOPT-NEXT:    jmpnerel .LBB0_1
; NOOPT-NEXT:  # %bb.2: # %exit
; NOOPT-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %idx = phi i32 [ 0, %entry ], [ %t, %loop ]
  %acc = phi i64 [ 0, %entry ], [ %acc.next, %loop ]
  %z = zext i32 %idx to i64
  %p = getelementptr inbounds i64, ptr %b, i64 %z
  %v = load volatile i64, ptr %p, align 8
  %t = trunc i64 %v to i32
  %tz = zext i32 %t to i64
  %acc.next = add i64 %acc, %tz
  %i.next = add i32 %i, 1
  %c = icmp eq i32 %i.next, 200000
  br i1 %c, label %exit, label %loop

exit:
  ret i64 %acc.next
}
