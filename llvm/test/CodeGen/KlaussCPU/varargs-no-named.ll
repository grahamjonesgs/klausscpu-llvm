; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -march=klausscpu -verify-machineinstrs -O1 < %s | FileCheck %s

; A variadic function with no named parameter (C23 f(...)): every caller of
; a variadic function reserves a home slot for each of R0-R3 above the
; return address ([incoming_SP+8..39]), so the callee stores all four and
; va_start is R0's slot.  (Before the home area covered R0 this was
; diagnosed as unsupported: R0's slot would have been the return address.)

define i64 @no_named(...) nounwind {
; CHECK-LABEL: no_named:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 1
; CHECK-NEXT:    addi r14, r15, 24
; CHECK-NEXT:    copy r12, r0
; CHECK-NEXT:    stidx64 r3, r15, 40
; CHECK-NEXT:    stidx64 r2, r15, 32
; CHECK-NEXT:    stidx64 r1, r15, 24
; CHECK-NEXT:    stidx64 r0, r15, 16
; CHECK-NEXT:    stidx64 r14, r15, -8
; CHECK-NEXT:    leaveret
  %ap = alloca ptr
  call void @llvm.va_start.p0(ptr %ap)
  %v = va_arg ptr %ap, i64
  call void @llvm.va_end.p0(ptr %ap)
  ret i64 %v
}

; The caller reserves the 32-byte home area, here with nothing else in the
; call frame.
define i64 @caller() nounwind {
; CHECK-LABEL: caller:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 4
; CHECK-NEXT:    setr r0, 1
; CHECK-NEXT:    setr r1, 2
; CHECK-NEXT:    callrel no_named
; CHECK-NEXT:    leaveret
  %r = call i64 (...) @no_named(i64 1, i64 2)
  ret i64 %r
}

; A fifth argument of a variadic call goes above the home area.
declare i64 @ext(i64, ...)
define i64 @caller5(i64 %a) nounwind {
; CHECK-LABEL: caller5:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 5
; CHECK-NEXT:    getsp r12
; CHECK-NEXT:    setr r14, 4
; CHECK-NEXT:    setr r1, 1
; CHECK-NEXT:    setr r2, 2
; CHECK-NEXT:    setr r3, 3
; CHECK-NEXT:    stidx64 r14, r12, 32
; CHECK-NEXT:    callrel ext
; CHECK-NEXT:    leaveret
  %r = call i64 (i64, ...) @ext(i64 %a, i64 1, i64 2, i64 3, i64 4)
  ret i64 %r
}

declare void @llvm.va_start.p0(ptr)
declare void @llvm.va_end.p0(ptr)
