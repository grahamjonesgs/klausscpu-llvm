; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=klausscpu -verify-machineinstrs -O1 < %s | FileCheck %s
; RUN: llc -mtriple=klausscpu -verify-machineinstrs -O1 \
; RUN:   -klausscpu-shrink-wrap=false < %s | FileCheck %s --check-prefix=NOSW
;
; Shrink-wrapping: the frame (ENTER, the callee-saved spills) is set up only
; on the paths that need it, so an early exit runs frameless.  The epilogue
; goes where it becomes LEAVERET (canUseAsEpilogue); a LEAVE that tail
; duplication leaves in front of a RET, with instructions that do not use the
; frame between them, is folded into LEAVERET (KlaussCPULeaveRet.cpp).

declare i64 @g(i64)

; if (!p) return 0; return g(*p) + 1;
define i64 @early_exit(ptr %p) nounwind {
;
; CHECK-LABEL: early_exit:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    fbri r0, 0, 0, .LBB0_1
; CHECK-NEXT:  # %bb.2: # %work
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx64 r0, r0, 0
; CHECK-NEXT:    callrel g
; CHECK-NEXT:    incr r12, r12
; CHECK-NEXT:    leaveret
; CHECK-NEXT:  .LBB0_1:
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    ret
;
; NOSW-LABEL: early_exit:
; NOSW:       # %bb.0: # %entry
; NOSW-NEXT:    enter 0
; NOSW-NEXT:    fbri r0, 0, 0, .LBB0_1
; NOSW-NEXT:  # %bb.2: # %work
; NOSW-NEXT:    ldidx64 r0, r0, 0
; NOSW-NEXT:    callrel g
; NOSW-NEXT:    incr r12, r12
; NOSW-NEXT:    leaveret
; NOSW-NEXT:  .LBB0_1:
; NOSW-NEXT:    setr r12, 0
; NOSW-NEXT:    leaveret
entry:
  %c = icmp eq ptr %p, null
  br i1 %c, label %ret, label %work

work:
  %v = load i64, ptr %p
  %r = call i64 @g(i64 %v)
  %r1 = add i64 %r, 1
  br label %ret

ret:
  %x = phi i64 [ %r1, %work ], [ 0, %entry ]
  ret i64 %x
}

; The register allocator puts %m in a callee-saved register in the entry
; block, so the frame stays there (shrink-wrapping moves only what the code
; lets it).
define i32 @ack(i32 signext %m, i32 signext %n) nounwind {
;
; CHECK-LABEL: ack:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    enter 1
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    copy r12, r1
; CHECK-NEXT:    copy r4, r0
; CHECK-NEXT:    cmprvw r4, 0
; CHECK-NEXT:    jmpnerel .LBB1_2
; CHECK-NEXT:    jmprel .LBB1_6
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB1_5: # %if.end3
; CHECK-NEXT:    # in Loop: Header=BB1_2 Depth=1
; CHECK-NEXT:    sextw r0, r4
; CHECK-NEXT:    addiw r1, r12, -1
; CHECK-NEXT:    callrel ack
; CHECK-NEXT:    decr r4, r4
; CHECK-NEXT:    cmprvw r4, 0
; CHECK-NEXT:    jmperel .LBB1_6
; CHECK-NEXT:  .LBB1_2: # %if.end
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    cmprvw r12, 0
; CHECK-NEXT:    jmpnerel .LBB1_5
; CHECK-NEXT:  # %bb.3: # in Loop: Header=BB1_2 Depth=1
; CHECK-NEXT:    setr r12, 1
; CHECK-NEXT:    decr r4, r4
; CHECK-NEXT:    cmprvw r4, 0
; CHECK-NEXT:    jmpnerel .LBB1_2
; CHECK-NEXT:  .LBB1_6: # %if.then
; CHECK-NEXT:    incr r12, r12
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
;
; NOSW-LABEL: ack:
; NOSW:       # %bb.0: # %entry
; NOSW-NEXT:    enter 1
; NOSW-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; NOSW-NEXT:    copy r12, r1
; NOSW-NEXT:    copy r4, r0
; NOSW-NEXT:    cmprvw r4, 0
; NOSW-NEXT:    jmpnerel .LBB1_2
; NOSW-NEXT:    jmprel .LBB1_6
; NOSW-NEXT:    .p2align 4
; NOSW-NEXT:  .LBB1_5: # %if.end3
; NOSW-NEXT:    # in Loop: Header=BB1_2 Depth=1
; NOSW-NEXT:    sextw r0, r4
; NOSW-NEXT:    addiw r1, r12, -1
; NOSW-NEXT:    callrel ack
; NOSW-NEXT:    decr r4, r4
; NOSW-NEXT:    cmprvw r4, 0
; NOSW-NEXT:    jmperel .LBB1_6
; NOSW-NEXT:  .LBB1_2: # %if.end
; NOSW-NEXT:    # =>This Inner Loop Header: Depth=1
; NOSW-NEXT:    cmprvw r12, 0
; NOSW-NEXT:    jmpnerel .LBB1_5
; NOSW-NEXT:  # %bb.3: # in Loop: Header=BB1_2 Depth=1
; NOSW-NEXT:    setr r12, 1
; NOSW-NEXT:    decr r4, r4
; NOSW-NEXT:    cmprvw r4, 0
; NOSW-NEXT:    jmpnerel .LBB1_2
; NOSW-NEXT:  .LBB1_6: # %if.then
; NOSW-NEXT:    incr r12, r12
; NOSW-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; NOSW-NEXT:    leaveret
entry:
  br label %tailrecurse

tailrecurse:
  %m.tr = phi i32 [ %m, %entry ], [ %sub, %if.end3 ], [ %sub, %if.end ]
  %n.tr = phi i32 [ %n, %entry ], [ %call6, %if.end3 ], [ 1, %if.end ]
  %cmp = icmp eq i32 %m.tr, 0
  br i1 %cmp, label %if.then, label %if.end

if.then:
  %add = add nsw i32 %n.tr, 1
  ret i32 %add

if.end:
  %cmp1 = icmp eq i32 %n.tr, 0
  %sub = add nsw i32 %m.tr, -1
  br i1 %cmp1, label %tailrecurse, label %if.end3

if.end3:
  %sub5 = add nsw i32 %n.tr, -1
  %call6 = tail call signext i32 @ack(i32 signext %m.tr, i32 signext %sub5)
  br label %tailrecurse
}

; The stack argument needs the frame only on one path, which tail
; duplication makes a return of its own: ENTER ... LEAVERET there.  The
; restore point is never the load's block while that block goes on to a
; compare and branch (canUseAsEpilogue): its LEAVE would be one more
; instruction and keep the two from fusing.
define i64 @stack_arg_late(i64 %a, i64 %b, i64 %c, i64 %d, i64 %x) nounwind {
;
; CHECK-LABEL: stack_arg_late:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fbr r0, r1, 1, .LBB2_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    copy r2, r3
; CHECK-NEXT:  .LBB2_2:
; CHECK-NEXT:    fbr r0, r1, 1, .LBB2_4
; CHECK-NEXT:  # %bb.3:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx64 r12, r15, 16
; CHECK-NEXT:    addr r12, r2, r12
; CHECK-NEXT:    leaveret
; CHECK-NEXT:  .LBB2_4:
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    addr r12, r2, r12
; CHECK-NEXT:    ret
;
; NOSW-LABEL: stack_arg_late:
; NOSW:       # %bb.0:
; NOSW-NEXT:    enter 0
; NOSW-NEXT:    fbr r0, r1, 1, .LBB2_2
; NOSW-NEXT:  # %bb.1:
; NOSW-NEXT:    copy r2, r3
; NOSW-NEXT:  .LBB2_2:
; NOSW-NEXT:    fbr r0, r1, 1, .LBB2_4
; NOSW-NEXT:  # %bb.3:
; NOSW-NEXT:    ldidx64 r12, r15, 16
; NOSW-NEXT:    addr r12, r2, r12
; NOSW-NEXT:    leaveret
; NOSW-NEXT:  .LBB2_4:
; NOSW-NEXT:    setr r12, 0
; NOSW-NEXT:    addr r12, r2, r12
; NOSW-NEXT:    leaveret
  %c1 = icmp slt i64 %a, %b
  %s1 = select i1 %c1, i64 %c, i64 %d
  %c2 = icmp sge i64 %a, %b
  %s2 = select i1 %c2, i64 %x, i64 0
  %r = add i64 %s1, %s2
  ret i64 %r
}

