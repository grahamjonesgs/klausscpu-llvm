; Inline memcpy / memset, under-aligned 32-bit loads, and va_arg.
;
; A memcpy from a constant initialiser stores the constant as immediates (no
; loads from .rodata, no SHLV + ORR to assemble i64 words from narrower
; loads).  A stack object or a global defined here that a memcpy reads or
; writes is given 8-byte alignment (shouldAlignPointerArgs), so the copy
; moves 8 bytes per access.  An under-aligned source is copied at its own
; width, or 4 bytes at a time when it is under 4-byte aligned, rather than
; with split i64 loads, while that fits the store limit.
;
; An under-aligned non-volatile 32-bit load is one MEMGET32, the only 32-bit
; load that does not force-align its address (an under-aligned 64-bit load
; two of them); the base + offset, reg + reg and frame forms are not used
; for it.  Volatile loads and every store stay byte accesses.

@cint = private unnamed_addr constant [6 x i32] [i32 1, i32 2, i32 3, i32 4, i32 5, i32 6], align 4
@cstr = private unnamed_addr constant [16 x i8] c"hello world\00\00\00\00\00", align 1
@gint = internal global [6 x i32] [i32 1, i32 2, i32 3, i32 4, i32 5, i32 6], align 4

declare void @use(ptr)

; int a[6] = {1, 2, 3, 4, 5, 6};
define void @init_ints() nounwind {
; CHECK-LABEL: init_ints:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 3
; CHECK-NEXT:    setr64 r12, 5, 6
; CHECK-NEXT:    setr64 r13, 3, 4
; CHECK-NEXT:    setr64 r14, 1, 2
; CHECK-NEXT:    addi r0, r15, -24
; CHECK-NEXT:    stidx64 r12, r15, -8
; CHECK-NEXT:    stidx64 r13, r15, -16
; CHECK-NEXT:    stidx64 r14, r15, -24
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    leaveret
  %a = alloca [6 x i32], align 4
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %a, ptr align 4 @cint, i64 24, i1 false)
  call void @use(ptr %a)
  ret void
}

