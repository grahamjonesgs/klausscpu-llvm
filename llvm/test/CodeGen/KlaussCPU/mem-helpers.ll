; va_arg on a va_list passed in (vprintf-style): every slot is 8 bytes and
; 8-aligned, so the pointer is advanced by 8 without being realigned, and the
; whole slot is loaded and truncated.
define i64 @va_sum(i32 %n, ptr %ap) nounwind {
; CHECK-LABEL: va_sum:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    cmprvw r0, 1
; CHECK-NEXT:    jmpltrel .LBB9_2
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB9_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldidx64 r14, r1, 0
; CHECK-NEXT:    addiw r0, r0, -1
; CHECK-NEXT:    addi r13, r14, 8
; CHECK-NEXT:    stidx64 r13, r1, 0
; CHECK-NEXT:    ldidx64 r14, r14, 0
; CHECK-NEXT:    sextw r14, r14
; CHECK-NEXT:    addr r12, r12, r14
; CHECK-NEXT:    fbri r0, 0, 8, .LBB9_1
; CHECK-NEXT:  .LBB9_2: # %done
; CHECK-NEXT:    ret
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %loop, label %done

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %s = phi i64 [ 0, %entry ], [ %s.next, %loop ]
  %v = va_arg ptr %ap, i32
  %v64 = sext i32 %v to i64
  %s.next = add i64 %s, %v64
  %i.next = add i32 %i, 1
  %c = icmp eq i32 %i.next, %n
  br i1 %c, label %done, label %loop

done:
  %r = phi i64 [ 0, %entry ], [ %s.next, %loop ]
  ret i64 %r
}

