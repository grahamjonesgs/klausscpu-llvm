; if/else converging at a single exit.
define i64 @if_else(i64 %a, i64 %b) {
; CHECK-LABEL: if_else:
; CHECK:       # %bb.0:
; CHECK-NEXT:    push r15
; CHECK-NEXT:    getsp r15
; CHECK-NEXT:    cmprr r0, r1
; CHECK-NEXT:    jmple .LBB5_2
; CHECK-NEXT:  # %bb.1: # %then
; CHECK-NEXT:    incr r0
; CHECK-NEXT:    jmp .LBB5_3
; CHECK-NEXT:  .LBB5_2: # %else
; CHECK-NEXT:    decr r1
; CHECK-NEXT:    copy r0, r1
; CHECK-NEXT:  .LBB5_3: # %exit
; CHECK-NEXT:    copy r12, r0
; CHECK-NEXT:    setsp r15
; CHECK-NEXT:    pop r15
; CHECK-NEXT:    ret
  %c = icmp sgt i64 %a, %b
  br i1 %c, label %then, label %else
then:
  %t = add i64 %a, 1
  br label %exit
else:
  %e = sub i64 %b, 1
  br label %exit
exit:
  %r = phi i64 [ %t, %then ], [ %e, %else ]
  ret i64 %r
}

; Countdown loop: while (n > 0) n--; return n;
define i64 @countdown(i64 %n) {
; CHECK-LABEL: countdown:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    push r15
; CHECK-NEXT:    getsp r15
; CHECK-NEXT:    incr r0
; CHECK-NEXT:  .LBB6_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    decr r0
; CHECK-NEXT:    cmprv r0, 0
; CHECK-NEXT:    jmpgt .LBB6_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    copy r12, r0
; CHECK-NEXT:    setsp r15
; CHECK-NEXT:    pop r15
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i64 [ %n, %entry ], [ %dec, %loop ]
  %c = icmp sgt i64 %i, 0
  %dec = add i64 %i, -1
  br i1 %c, label %loop, label %exit
exit:
  ret i64 %i
}

; Sum loop: for (i=0; i<n; i++) sum += i;
define i64 @sum_loop(i64 %n) {
; CHECK-LABEL: sum_loop:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    push r15
; CHECK-NEXT:    getsp r15
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    copy r14, r12
; CHECK-NEXT:  .LBB7_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    addr r12, r12, r14
; CHECK-NEXT:    incr r14
; CHECK-NEXT:    cmprr r14, r0
; CHECK-NEXT:    jmplt .LBB7_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    setsp r15
; CHECK-NEXT:    pop r15
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i   = phi i64 [ 0, %entry ], [ %i1,   %loop ]
  %sum = phi i64 [ 0, %entry ], [ %sum1, %loop ]
  %sum1 = add i64 %sum, %i
  %i1   = add i64 %i,   1
  %c    = icmp slt i64 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i64 %sum1
}
