; Equal: CMPRV with constant 0 + JMPE
define i64 @eq_zero(i64 %a) {
; CHECK-LABEL: eq_zero:
; CHECK:       # %bb.0:
; CHECK-NEXT:    push r15
; CHECK-NEXT:    getsp r15
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    cmpeqr r12, r0, r12
; CHECK-NEXT:    cmprv r12, 0
; CHECK-NEXT:    jmpe .LBB3_1
; CHECK-NEXT:    jmp .LBB3_2
; CHECK-NEXT:  .LBB3_1:
; CHECK-NEXT:    setr r12, 20
; CHECK-NEXT:    jmp .LBB3_3
; CHECK-NEXT:  .LBB3_2:
; CHECK-NEXT:    setr r12, 10
; CHECK-NEXT:  .LBB3_3:
; CHECK-NEXT:    setsp r15
; CHECK-NEXT:    pop r15
; CHECK-NEXT:    ret
  %c = icmp eq i64 %a, 0
