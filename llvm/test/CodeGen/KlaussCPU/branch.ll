; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -march=klausscpu -O1 < %s | FileCheck %s

; Branches: all 10 integer condition codes, if/else, loops.

; Signed less-than: CMPRR + JMPLT
define i64 @slt(i64 %a, i64 %b) {
; CHECK-LABEL: slt:
; CHECK:       # %bb.0:
; CHECK-NEXT:    push r15
; CHECK-NEXT:    getsp r15
; CHECK-NEXT:    cmpltr r12, r0, r1
; CHECK-NEXT:    andv r12, 1
; CHECK-NEXT:    setsp r15
; CHECK-NEXT:    pop r15
; CHECK-NEXT:    ret
  %c = icmp slt i64 %a, %b
  %r = select i1 %c, i64 1, i64 0
  ret i64 %r
}

