; A run of selects on the same condition shares one compare and branch, with
; one PHI per select (EmitInstrWithCustomInserter).  With
; -klausscpu-group-selects=false each select gets its own diamond.

; A swap: one compare, both values from one diamond.
define void @swap(i64 %a, i64 %b, ptr %p, ptr %q, i64 %c, i64 %d) nounwind {
; CHECK-LABEL: swap:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx64 r14, r15, 48
; CHECK-NEXT:    ldidx64 r12, r15, 40
; CHECK-NEXT:    fbr r0, r1, 4, .LBB0_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    copy r13, r12
; CHECK-NEXT:    copy r12, r14
; CHECK-NEXT:    jmprel .LBB0_3
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    copy r13, r14
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:    stidx64 r13, r2, 0
; CHECK-NEXT:    stidx64 r12, r3, 0
; CHECK-NEXT:    leaveret
;
; NOGROUP-LABEL: swap:
; NOGROUP:       # %bb.0:
; NOGROUP-NEXT:    enter 0
; NOGROUP-NEXT:    ldidx64 r14, r15, 40
; NOGROUP-NEXT:    ldidx64 r12, r15, 48
; NOGROUP-NEXT:    cmprr r0, r1
; NOGROUP-NEXT:    copy r13, r14
; NOGROUP-NEXT:    jmpugtrel .LBB0_2
; NOGROUP-NEXT:  # %bb.1:
; NOGROUP-NEXT:    copy r13, r12
; NOGROUP-NEXT:  .LBB0_2:
; NOGROUP-NEXT:    fbr r0, r1, 12, .LBB0_4
; NOGROUP-NEXT:  # %bb.3:
; NOGROUP-NEXT:    copy r12, r14
; NOGROUP-NEXT:  .LBB0_4:
; NOGROUP-NEXT:    stidx64 r13, r2, 0
; NOGROUP-NEXT:    stidx64 r12, r3, 0
; NOGROUP-NEXT:    leaveret
  %cmp = icmp ugt i64 %a, %b
  %x = select i1 %cmp, i64 %c, i64 %d
  %y = select i1 %cmp, i64 %d, i64 %c
  store i64 %x, ptr %p
  store i64 %y, ptr %q
  ret void
}

