; NOGROUP-NEXT:    enter 0
; NOGROUP-NEXT:    andv r14, r2, 64
; NOGROUP-NEXT:    shlr r12, r0, r2
; NOGROUP-NEXT:    fbri r14, 0, 8, .LBB3_2
; NOGROUP-NEXT:  # %bb.1:
; NOGROUP-NEXT:    notr r13, r2
; NOGROUP-NEXT:    shrv r11, r0, 1
; NOGROUP-NEXT:    shlr r10, r1, r2
; NOGROUP-NEXT:    shrr r13, r11, r13
; NOGROUP-NEXT:    orr r11, r10, r13
; NOGROUP-NEXT:    fbri r14, 0, 8, .LBB3_4
; NOGROUP-NEXT:    jmprel .LBB3_5
; NOGROUP-NEXT:  .LBB3_2:
; NOGROUP-NEXT:    copy r11, r12
; NOGROUP-NEXT:    fbri r14, 0, 0, .LBB3_5
; NOGROUP-NEXT:  .LBB3_4:
; NOGROUP-NEXT:    setr r12, 0
; NOGROUP-NEXT:  .LBB3_5:
; NOGROUP-NEXT:    leaveret
  %r = shl i128 %a, %b
  ret i128 %r
}

; The second select's true value is computed from the first select's result,
; so the run ends at that add: two compares.
define i64 @chain(i64 %a, i64 %b, i64 %c, i64 %d) nounwind {
; CHECK-LABEL: chain:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    fbr r0, r1, 9, .LBB4_1
; CHECK-NEXT:  # %bb.2:
; CHECK-NEXT:    fbr r0, r1, 1, .LBB4_3
; CHECK-NEXT:  .LBB4_4:
; CHECK-NEXT:    mulr r12, r2, r3
; CHECK-NEXT:    leaveret
; CHECK-NEXT:  .LBB4_1:
; CHECK-NEXT:    copy r2, r3
; CHECK-NEXT:    fbr r0, r1, 9, .LBB4_4
; CHECK-NEXT:  .LBB4_3:
; CHECK-NEXT:    incr r3, r2
; CHECK-NEXT:    mulr r12, r2, r3
; CHECK-NEXT:    leaveret
;
; NOGROUP-LABEL: chain:
; NOGROUP:       # %bb.0:
; NOGROUP-NEXT:    enter 0
; NOGROUP-NEXT:    fbr r0, r1, 9, .LBB4_1
; NOGROUP-NEXT:  # %bb.2:
; NOGROUP-NEXT:    fbr r0, r1, 1, .LBB4_3
; NOGROUP-NEXT:  .LBB4_4:
; NOGROUP-NEXT:    mulr r12, r2, r3
; NOGROUP-NEXT:    leaveret
; NOGROUP-NEXT:  .LBB4_1:
; NOGROUP-NEXT:    copy r2, r3
; NOGROUP-NEXT:    fbr r0, r1, 9, .LBB4_4
; NOGROUP-NEXT:  .LBB4_3:
; NOGROUP-NEXT:    incr r3, r2
; NOGROUP-NEXT:    mulr r12, r2, r3
; NOGROUP-NEXT:    leaveret
  %cmp = icmp slt i64 %a, %b
  %x = select i1 %cmp, i64 %c, i64 %d
  %t = add i64 %x, 1
  %y = select i1 %cmp, i64 %t, i64 %d
  %s = mul i64 %x, %y
  ret i64 %s
}

