# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=klausscpu -run-pass=klausscpu-opt-ext -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s
# RUN: llc -mtriple=klausscpu -run-pass=klausscpu-opt-ext -verify-machineinstrs \
# RUN:   -klausscpu-w32-alu=false %s -o - | FileCheck %s --check-prefix=OFF
#
# KlaussCPUOptExtensions rule 4: a SEXTW of an add, subtract or multiply that
# every reader reads only in its low 32 bits (the SEXTW, a 32-bit store, a W
# op, through COPY/PHI and ops with dead FLAGS) makes that op its W form and
# goes.  Every immediate form becomes ADDIW of the immediate's low 32 bits
# (INCR 1, DECR -1, MINUSV the negation, ADDV a constant above INT32_MAX).
# Not when another reader takes the whole register (a physical register),
# when the op's FLAGS are live, for an ADDI of a frame index (ADDIW of one
# would cost eliminateFrameIndex a scratch ADDI), or with
# -klausscpu-w32-alu=false.

--- |
  define void @wops() { ret void }
  define void @counter() { ret void }
  define void @wide_reader() { ret void }
  define void @flags_live() { ret void }
  define void @frame_index() { ret void }
...
---
name:            wops
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2
    ; CHECK-LABEL: name: wops
    ; CHECK: liveins: $r0, $r1, $r2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY $r2
    ; CHECK-NEXT: [[ADDW:%[0-9]+]]:gpr = ADDW [[COPY]], [[COPY1]], implicit-def dead $flags
    ; CHECK-NEXT: STIDX32 [[ADDW]], [[COPY2]], 0
    ; CHECK-NEXT: [[SUBW:%[0-9]+]]:gpr = SUBW [[COPY]], [[COPY1]], implicit-def dead $flags
    ; CHECK-NEXT: [[MULW:%[0-9]+]]:gpr = MULW [[COPY]], [[COPY1]], implicit-def dead $flags
    ; CHECK-NEXT: [[ADDIW:%[0-9]+]]:gpr = ADDIW [[COPY]], -7, implicit-def dead $flags
    ; CHECK-NEXT: [[ADDIW1:%[0-9]+]]:gpr = ADDIW [[COPY]], -294967296, implicit-def dead $flags
    ; CHECK-NEXT: [[ADDIW2:%[0-9]+]]:gpr = ADDIW [[COPY1]], -5, implicit-def dead $flags
    ; CHECK-NEXT: [[ADDIW3:%[0-9]+]]:gpr = ADDIW [[COPY1]], 1, implicit-def dead $flags
    ; CHECK-NEXT: [[ADDIW4:%[0-9]+]]:gpr = ADDIW [[COPY1]], -1, implicit-def dead $flags
    ; CHECK-NEXT: [[ORR:%[0-9]+]]:gpr = ORR [[ADDW]], [[SUBW]]
    ; CHECK-NEXT: [[ORR1:%[0-9]+]]:gpr = ORR [[MULW]], [[ADDIW]]
    ; CHECK-NEXT: [[ORR2:%[0-9]+]]:gpr = ORR [[ADDIW1]], [[ADDIW2]]
    ; CHECK-NEXT: [[ORR3:%[0-9]+]]:gpr = ORR [[ADDIW3]], [[ADDIW4]]
    ; CHECK-NEXT: [[ORR4:%[0-9]+]]:gpr = ORR [[ORR]], [[ORR1]]
    ; CHECK-NEXT: [[ORR5:%[0-9]+]]:gpr = ORR [[ORR2]], [[ORR3]]
    ; CHECK-NEXT: [[ORR6:%[0-9]+]]:gpr = ORR [[ORR4]], [[ORR5]]
    ; CHECK-NEXT: $r12 = COPY [[ORR6]]
    ; CHECK-NEXT: RET_I implicit $r12
    ;
    ; OFF-LABEL: name: wops
    ; OFF: liveins: $r0, $r1, $r2
    ; OFF-NEXT: {{  $}}
    ; OFF-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r0
    ; OFF-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r1
    ; OFF-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY $r2
    ; OFF-NEXT: [[ADDR:%[0-9]+]]:gpr = ADDR [[COPY]], [[COPY1]], implicit-def dead $flags
    ; OFF-NEXT: STIDX32 [[ADDR]], [[COPY2]], 0
    ; OFF-NEXT: [[SEXTW:%[0-9]+]]:gpr = SEXTW [[ADDR]]
    ; OFF-NEXT: [[SUBR:%[0-9]+]]:gpr = SUBR [[COPY]], [[COPY1]], implicit-def dead $flags
    ; OFF-NEXT: [[SEXTW1:%[0-9]+]]:gpr = SEXTW [[SUBR]]
    ; OFF-NEXT: [[MULR:%[0-9]+]]:gpr = MULR [[COPY]], [[COPY1]], implicit-def dead $flags
    ; OFF-NEXT: [[SEXTW2:%[0-9]+]]:gpr = SEXTW [[MULR]]
    ; OFF-NEXT: [[ADDI:%[0-9]+]]:gpr = ADDI [[COPY]], -7, implicit-def dead $flags
    ; OFF-NEXT: [[SEXTW3:%[0-9]+]]:gpr = SEXTW [[ADDI]]
    ; OFF-NEXT: [[ADDV:%[0-9]+]]:gpr = ADDV [[COPY]], 4000000000, implicit-def dead $flags
    ; OFF-NEXT: [[SEXTW4:%[0-9]+]]:gpr = SEXTW [[ADDV]]
    ; OFF-NEXT: [[MINUSV:%[0-9]+]]:gpr = MINUSV [[COPY1]], 5, implicit-def dead $flags
    ; OFF-NEXT: [[SEXTW5:%[0-9]+]]:gpr = SEXTW [[MINUSV]]
    ; OFF-NEXT: [[INCR:%[0-9]+]]:gpr = INCR [[COPY1]], implicit-def dead $flags
    ; OFF-NEXT: [[SEXTW6:%[0-9]+]]:gpr = SEXTW [[INCR]]
    ; OFF-NEXT: [[DECR:%[0-9]+]]:gpr = DECR [[COPY1]], implicit-def dead $flags
    ; OFF-NEXT: [[SEXTW7:%[0-9]+]]:gpr = SEXTW [[DECR]]
    ; OFF-NEXT: [[ORR:%[0-9]+]]:gpr = ORR [[SEXTW]], [[SEXTW1]]
    ; OFF-NEXT: [[ORR1:%[0-9]+]]:gpr = ORR [[SEXTW2]], [[SEXTW3]]
    ; OFF-NEXT: [[ORR2:%[0-9]+]]:gpr = ORR [[SEXTW4]], [[SEXTW5]]
    ; OFF-NEXT: [[ORR3:%[0-9]+]]:gpr = ORR [[SEXTW6]], [[SEXTW7]]
    ; OFF-NEXT: [[ORR4:%[0-9]+]]:gpr = ORR [[ORR]], [[ORR1]]
    ; OFF-NEXT: [[ORR5:%[0-9]+]]:gpr = ORR [[ORR2]], [[ORR3]]
    ; OFF-NEXT: [[ORR6:%[0-9]+]]:gpr = ORR [[ORR4]], [[ORR5]]
    ; OFF-NEXT: $r12 = COPY [[ORR6]]
    ; OFF-NEXT: RET_I implicit $r12
    %0:gpr = COPY $r0
    %1:gpr = COPY $r1
    %2:gpr = COPY $r2
    %10:gpr = ADDR %0, %1, implicit-def dead $flags
    STIDX32 %10, %2, 0
    %11:gpr = SEXTW %10
    %12:gpr = SUBR %0, %1, implicit-def dead $flags
    %13:gpr = SEXTW %12
    %14:gpr = MULR %0, %1, implicit-def dead $flags
    %15:gpr = SEXTW %14
    %16:gpr = ADDI %0, -7, implicit-def dead $flags
    %17:gpr = SEXTW %16
    %18:gpr = ADDV %0, 4000000000, implicit-def dead $flags
    %19:gpr = SEXTW %18
    %20:gpr = MINUSV %1, 5, implicit-def dead $flags
    %21:gpr = SEXTW %20
    %22:gpr = INCR %1, implicit-def dead $flags
    %23:gpr = SEXTW %22
    %24:gpr = DECR %1, implicit-def dead $flags
    %25:gpr = SEXTW %24
    %30:gpr = ORR %11, %13
    %31:gpr = ORR %15, %17
    %32:gpr = ORR %19, %21
    %33:gpr = ORR %23, %25
    %34:gpr = ORR %30, %31
    %35:gpr = ORR %32, %33
    %36:gpr = ORR %34, %35
    $r12 = COPY %36
    RET_I implicit $r12
...
---
name:            counter
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: counter
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r0
  ; CHECK-NEXT:   [[SETR:%[0-9]+]]:gpr = SETR 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[SETR]], %bb.0, %3, %bb.1
  ; CHECK-NEXT:   [[ADDIW:%[0-9]+]]:gpr = ADDIW [[PHI]], 1, implicit-def dead $flags
  ; CHECK-NEXT:   CMPRR_I [[ADDIW]], [[COPY]], implicit-def $flags
  ; CHECK-NEXT:   JMPULT %bb.1, implicit $flags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $r12 = COPY [[ADDIW]]
  ; CHECK-NEXT:   RET_I implicit $r12
  ;
  ; OFF-LABEL: name: counter
  ; OFF: bb.0:
  ; OFF-NEXT:   successors: %bb.1(0x80000000)
  ; OFF-NEXT:   liveins: $r0
  ; OFF-NEXT: {{  $}}
  ; OFF-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r0
  ; OFF-NEXT:   [[SETR:%[0-9]+]]:gpr = SETR 0
  ; OFF-NEXT: {{  $}}
  ; OFF-NEXT: bb.1:
  ; OFF-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; OFF-NEXT: {{  $}}
  ; OFF-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[SETR]], %bb.0, %3, %bb.1
  ; OFF-NEXT:   [[INCR:%[0-9]+]]:gpr = INCR [[PHI]], implicit-def dead $flags
  ; OFF-NEXT:   [[SEXTW:%[0-9]+]]:gpr = SEXTW [[INCR]]
  ; OFF-NEXT:   CMPRR_I [[SEXTW]], [[COPY]], implicit-def $flags
  ; OFF-NEXT:   JMPULT %bb.1, implicit $flags
  ; OFF-NEXT: {{  $}}
  ; OFF-NEXT: bb.2:
  ; OFF-NEXT:   [[SEXTW1:%[0-9]+]]:gpr = SEXTW [[INCR]]
  ; OFF-NEXT:   $r12 = COPY [[SEXTW1]]
  ; OFF-NEXT:   RET_I implicit $r12
  bb.0:
    successors: %bb.1
    liveins: $r0
    %0:gpr = COPY $r0
    %1:gpr = SETR 0

  bb.1:
    successors: %bb.1, %bb.2
    %2:gpr = PHI %1, %bb.0, %3, %bb.1
    %3:gpr = INCR %2, implicit-def dead $flags
    %4:gpr = SEXTW %3
    CMPRR_I %4, %0, implicit-def $flags
    JMPULT %bb.1, implicit $flags

  bb.2:
    %5:gpr = SEXTW %3
    $r12 = COPY %5
    RET_I implicit $r12
...
---
name:            wide_reader
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1
    ; CHECK-LABEL: name: wide_reader
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r1
    ; CHECK-NEXT: [[ADDR:%[0-9]+]]:gpr = ADDR [[COPY]], [[COPY1]], implicit-def dead $flags
    ; CHECK-NEXT: [[SEXTW:%[0-9]+]]:gpr = SEXTW [[ADDR]]
    ; CHECK-NEXT: $r11 = COPY [[ADDR]]
    ; CHECK-NEXT: $r12 = COPY [[SEXTW]]
    ; CHECK-NEXT: RET_I implicit $r12, implicit $r11
    ;
    ; OFF-LABEL: name: wide_reader
    ; OFF: liveins: $r0, $r1
    ; OFF-NEXT: {{  $}}
    ; OFF-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r0
    ; OFF-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r1
    ; OFF-NEXT: [[ADDR:%[0-9]+]]:gpr = ADDR [[COPY]], [[COPY1]], implicit-def dead $flags
    ; OFF-NEXT: [[SEXTW:%[0-9]+]]:gpr = SEXTW [[ADDR]]
    ; OFF-NEXT: $r11 = COPY [[ADDR]]
    ; OFF-NEXT: $r12 = COPY [[SEXTW]]
    ; OFF-NEXT: RET_I implicit $r12, implicit $r11
    %0:gpr = COPY $r0
    %1:gpr = COPY $r1
    %2:gpr = ADDR %0, %1, implicit-def dead $flags
    %3:gpr = SEXTW %2
    $r11 = COPY %2
    $r12 = COPY %3
    RET_I implicit $r12, implicit $r11
...
---
name:            flags_live
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: flags_live
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $r0, $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $r1
  ; CHECK-NEXT:   [[ADDR:%[0-9]+]]:gpr = ADDR [[COPY]], [[COPY1]], implicit-def $flags
  ; CHECK-NEXT:   [[SEXTW:%[0-9]+]]:gpr = SEXTW [[ADDR]]
  ; CHECK-NEXT:   JMPE %bb.2, implicit $flags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $r12 = COPY [[SEXTW]]
  ; CHECK-NEXT:   RET_I implicit $r12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $r12 = COPY [[COPY]]
  ; CHECK-NEXT:   RET_I implicit $r12
  ;
  ; OFF-LABEL: name: flags_live
  ; OFF: bb.0:
  ; OFF-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; OFF-NEXT:   liveins: $r0, $r1
  ; OFF-NEXT: {{  $}}
  ; OFF-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r0
  ; OFF-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $r1
  ; OFF-NEXT:   [[ADDR:%[0-9]+]]:gpr = ADDR [[COPY]], [[COPY1]], implicit-def $flags
  ; OFF-NEXT:   [[SEXTW:%[0-9]+]]:gpr = SEXTW [[ADDR]]
  ; OFF-NEXT:   JMPE %bb.2, implicit $flags
  ; OFF-NEXT: {{  $}}
  ; OFF-NEXT: bb.1:
  ; OFF-NEXT:   $r12 = COPY [[SEXTW]]
  ; OFF-NEXT:   RET_I implicit $r12
  ; OFF-NEXT: {{  $}}
  ; OFF-NEXT: bb.2:
  ; OFF-NEXT:   $r12 = COPY [[COPY]]
  ; OFF-NEXT:   RET_I implicit $r12
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1
    %0:gpr = COPY $r0
    %1:gpr = COPY $r1
    %2:gpr = ADDR %0, %1, implicit-def $flags
    %3:gpr = SEXTW %2
    JMPE %bb.2, implicit $flags

  bb.1:
    $r12 = COPY %3
    RET_I implicit $r12

  bb.2:
    $r12 = COPY %0
    RET_I implicit $r12
...
---
name:            frame_index
tracksRegLiveness: true
stack:
  - { id: 0, size: 16, alignment: 8 }
body:             |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: frame_index
    ; CHECK: liveins: $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r0
    ; CHECK-NEXT: [[ADDI:%[0-9]+]]:gpr = ADDI %stack.0, 4, implicit-def dead $flags
    ; CHECK-NEXT: [[SEXTW:%[0-9]+]]:gpr = SEXTW [[ADDI]]
    ; CHECK-NEXT: $r12 = COPY [[SEXTW]]
    ; CHECK-NEXT: RET_I implicit $r12
    ;
    ; OFF-LABEL: name: frame_index
    ; OFF: liveins: $r0
    ; OFF-NEXT: {{  $}}
    ; OFF-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r0
    ; OFF-NEXT: [[ADDI:%[0-9]+]]:gpr = ADDI %stack.0, 4, implicit-def dead $flags
    ; OFF-NEXT: [[SEXTW:%[0-9]+]]:gpr = SEXTW [[ADDI]]
    ; OFF-NEXT: $r12 = COPY [[SEXTW]]
    ; OFF-NEXT: RET_I implicit $r12
    %0:gpr = COPY $r0
    %1:gpr = ADDI %stack.0, 4, implicit-def dead $flags
    %2:gpr = SEXTW %1
    $r12 = COPY %2
    RET_I implicit $r12
...
