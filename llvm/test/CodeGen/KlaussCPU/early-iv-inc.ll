; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -march=klausscpu -verify-machineinstrs -O1 < %s | FileCheck %s
;
; KlaussCPUEarlyIVInc: a single-block loop whose exit test reads the
; incremented counter, and whose other counter uses wait for something
; slower anyway, counts from Init - C and compares with N - C, so the
; increment can issue early instead of directly before the branch.

; b = (b ^ (b << 3)) + i: the counter is read at the end of the chain.
; Rewritten: SETR -1 / 99, INCR off the end of the loop.
define i64 @data_use() nounwind {
; CHECK-LABEL: data_use:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    setr r12, 1
; CHECK-NEXT:    setr r14, -1
; CHECK-NEXT:    setr r11, 99
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    shlv r13, r12, 3
; CHECK-NEXT:    incr r14, r14
; CHECK-NEXT:    xorr r12, r13, r12
; CHECK-NEXT:    addr r12, r12, r14
; CHECK-NEXT:    fbr r14, r11, 8, .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %b = phi i64 [ 1, %entry ], [ %b.next, %loop ]
  %s = shl i64 %b, 3
  %x = xor i64 %s, %b
  %b.next = add i64 %x, %i
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, 100
  br i1 %done, label %exit, label %loop

exit:
  ret i64 %b.next
}

