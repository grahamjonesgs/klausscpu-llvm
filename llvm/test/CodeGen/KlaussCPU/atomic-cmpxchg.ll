; Forced atomics: cmpxchg of 1, 2, 4 or 8 bytes is a call to
; __sync_val_compare_and_swap_N, which returns the old value (zero-extended
; for a sub-word op); the success flag is the compare of that value with the
; expected one, zero-extended to the same width.

define i8 @cas_val_i8(ptr %p, i8 %e, i8 %n) nounwind {
; CHECK-LABEL: cas_val_i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 3
; CHECK-NEXT:    call __sync_val_compare_and_swap_1
; CHECK-NEXT:    leaveret
  %pair = cmpxchg ptr %p, i8 %e, i8 %n seq_cst seq_cst
  %v = extractvalue { i8, i1 } %pair, 0
  ret i8 %v
}

define i1 @cas_ok_i8(ptr %p, i8 %e, i8 %n) nounwind {
; CHECK-LABEL: cas_ok_i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 4
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r1
; CHECK-NEXT:    call __sync_val_compare_and_swap_1
; CHECK-NEXT:    zextb r14, r4
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    cmpeqr r12, r12, r14
; CHECK-NEXT:    leaveret
  %pair = cmpxchg ptr %p, i8 %e, i8 %n acq_rel monotonic
  %ok = extractvalue { i8, i1 } %pair, 1
  ret i1 %ok
}

