; A CAS loop: the flag drives the branch.
define void @cas_loop_inc(ptr %p) nounwind {
; CHECK-LABEL: cas_loop_inc:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    enter 5
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    stidx64 r5, r15, -16 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r0
; CHECK-NEXT:    ldidx64 r5, r0, 0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB9_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    incr r2, r5
; CHECK-NEXT:    copy r0, r4
; CHECK-NEXT:    copy r1, r5
; CHECK-NEXT:    call __sync_val_compare_and_swap_8
; CHECK-NEXT:    cmprr r12, r5
; CHECK-NEXT:    copy r5, r12
; CHECK-NEXT:    jmpnerel .LBB9_1
; CHECK-NEXT:  # %bb.2: # %done
; CHECK-NEXT:    ldidx64 r5, r15, -16 # 8-byte Folded Reload
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
entry:
  %init = load atomic i64, ptr %p monotonic, align 8
  br label %loop
loop:
  %old = phi i64 [ %init, %entry ], [ %cur, %loop ]
  %new = add i64 %old, 1
  %pair = cmpxchg ptr %p, i64 %old, i64 %new seq_cst monotonic
  %cur = extractvalue { i64, i1 } %pair, 0
  %ok = extractvalue { i64, i1 } %pair, 1
  br i1 %ok, label %done, label %loop
done:
  ret void
}

