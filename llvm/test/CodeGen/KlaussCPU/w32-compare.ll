; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --default-march klausscpu --version 6
; RUN: llc -march=klausscpu -verify-machineinstrs -O2 < %s | FileCheck %s

; ISA v3 D2: a compare of two 32-bit values uses CMPRRW/CMPRVW when that
; removes an extension instruction, i.e. the extension feeds nothing but
; compares of the same operands and condition.

declare void @f()

; Both extensions go: CMPRRW + branch.
define void @rr_both(i64 %a, i64 %b) nounwind {
; CHECK-LABEL: rr_both:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 3
; CHECK-NEXT:    cmprrw r0, r1
; CHECK-NEXT:    jmpgerel .LBB0_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    call f
; CHECK-NEXT:  .LBB0_2: # %e
; CHECK-NEXT:    leaveret
  %a1 = trunc i64 %a to i32
  %b1 = trunc i64 %b to i32
  %c = icmp slt i32 %a1, %b1
  br i1 %c, label %t, label %e
t:
  call void @f()
  br label %e
e:
  ret void
}

; One operand is already sign-extended; the other's extension goes.
define void @rr_one(i32 signext %a, i64 %b) nounwind {
; CHECK-LABEL: rr_one:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 3
; CHECK-NEXT:    cmprrw r0, r1
; CHECK-NEXT:    jmpgerel .LBB1_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    call f
; CHECK-NEXT:  .LBB1_2: # %e
; CHECK-NEXT:    leaveret
  %b1 = trunc i64 %b to i32
  %c = icmp slt i32 %a, %b1
  br i1 %c, label %t, label %e
t:
  call void @f()
  br label %e
e:
  ret void
}

; A compare with a constant.
define void @imm_large(i64 %a) nounwind {
; CHECK-LABEL: imm_large:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 3
; CHECK-NEXT:    cmprvw r0, 999
; CHECK-NEXT:    jmpgtrel .LBB2_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    call f
; CHECK-NEXT:  .LBB2_2: # %e
; CHECK-NEXT:    leaveret
  %a1 = trunc i64 %a to i32
  %c = icmp slt i32 %a1, 1000
  br i1 %c, label %t, label %e
t:
  call void @f()
  br label %e
e:
  ret void
}

; A simm4 constant: CMPRVW too, not the extension + FBRI.
define void @imm_small(i64 %a) nounwind {
; CHECK-LABEL: imm_small:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 3
; CHECK-NEXT:    cmprvw r0, 4
; CHECK-NEXT:    jmpgtrel .LBB3_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    call f
; CHECK-NEXT:  .LBB3_2: # %e
; CHECK-NEXT:    leaveret
  %a1 = trunc i64 %a to i32
  %c = icmp slt i32 %a1, 5
  br i1 %c, label %t, label %e
t:
  call void @f()
  br label %e
e:
  ret void
}

; A select with a constant outside simm4.
define i64 @sel_imm_large(i64 %a, i64 %x, i64 %y) nounwind {
; CHECK-LABEL: sel_imm_large:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    cmprvw r0, 1000
; CHECK-NEXT:    jmpultrel .LBB4_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    copy r1, r2
; CHECK-NEXT:  .LBB4_2:
; CHECK-NEXT:    copy r12, r1
; CHECK-NEXT:    leaveret
  %a1 = trunc i64 %a to i32
  %c = icmp ult i32 %a1, 1000
  %r = select i1 %c, i64 %x, i64 %y
  ret i64 %r
}

; The extension also feeds an add, so it stays and the compare is 64-bit.
define i64 @ext_used(i64 %a, i64 %b) nounwind {
; CHECK-LABEL: ext_used:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    sextw r12, r0
; CHECK-NEXT:    cmprv r12, 1000
; CHECK-NEXT:    jmpgerel .LBB5_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    addr r1, r12, r1
; CHECK-NEXT:  .LBB5_2:
; CHECK-NEXT:    copy r12, r1
; CHECK-NEXT:    leaveret
  %a1 = trunc i64 %a to i32
  %c = icmp slt i32 %a1, 1000
  %ax = sext i32 %a1 to i64
  %s = add i64 %ax, %b
  %r = select i1 %c, i64 %s, i64 %b
  ret i64 %r
}
