; __builtin_frame_address / __builtin_return_address.  Every function has a
; frame: R15 points at the saved caller R15, with the return address above
; it, so depth N follows the saved-R15 chain N times.

define ptr @frameaddr0() nounwind {
; CHECK-LABEL: frameaddr0:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    copy r12, r15
; CHECK-NEXT:    leaveret
;
; O0-LABEL: frameaddr0:
; O0:       # %bb.0:
; O0-NEXT:    enter 0
; O0-NEXT:    copy r12, r15
; O0-NEXT:    leaveret
  %p = call ptr @llvm.frameaddress.p0(i32 0)
  ret ptr %p
}

