# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=klausscpu -run-pass=klausscpu-opt-ext -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s
#
# KlaussCPUOptExtensions deletes an extension (1) of a value that is already
# extended, through PHI and COPY, (2) whose result is read only in its low
# bits, or (3) of a PHI whose incoming values can be the same extension made
# in each predecessor.  The negative cases keep theirs: a zero extension of a
# sign-extended value, a sign extension from 32 bits of a 32-bit zero
# extension, a shift that leaves bit 31, an address operand, live FLAGS, a
# negative mask, and a PHI with a 64-bit reader.

--- |
  define void @phi_of_loads() { ret void }
  define void @w_op_copy() { ret void }
  define void @kinds() { ret void }
  define void @shifts() { ret void }
  define void @masks() { ret void }
  define void @narrow_users() { ret void }
  define void @flags_live() { ret void }
  define void @phi_inputs() { ret void }
  define void @phi_wide_user() { ret void }
...
---
name:            phi_of_loads
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: phi_of_loads
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $r0, $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $r1
  ; CHECK-NEXT:   [[LDIDX32_:%[0-9]+]]:gpr = LDIDX32 [[COPY]], 0
  ; CHECK-NEXT:   CMPRV_I [[COPY1]], 0, implicit-def $flags
  ; CHECK-NEXT:   JMPE %bb.2, implicit $flags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDIDX32R:%[0-9]+]]:gpr = LDIDX32R [[COPY]], [[COPY1]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[LDIDX32_]], %bb.0, [[LDIDX32R]], %bb.1
  ; CHECK-NEXT:   $r12 = COPY [[PHI]]
  ; CHECK-NEXT:   RET_I implicit $r12
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1
    %0:gpr = COPY $r0
    %1:gpr = COPY $r1
    %2:gpr = LDIDX32 %0, 0
    CMPRV_I %1, 0, implicit-def $flags
    JMPE %bb.2, implicit $flags

  bb.1:
    %3:gpr = LDIDX32R %0, %1

  bb.2:
    %4:gpr = PHI %2, %bb.0, %3, %bb.1
    %5:gpr = ZEXTW %4, implicit-def dead $flags
    $r12 = COPY %5
    RET_I implicit $r12
...
---
name:            w_op_copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1
    ; CHECK-LABEL: name: w_op_copy
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r1
    ; CHECK-NEXT: [[ADDW:%[0-9]+]]:gpr = ADDW [[COPY]], [[COPY1]], implicit-def dead $flags
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY [[ADDW]]
    ; CHECK-NEXT: $r12 = COPY [[COPY2]]
    ; CHECK-NEXT: RET_I implicit $r12
    %0:gpr = COPY $r0
    %1:gpr = COPY $r1
