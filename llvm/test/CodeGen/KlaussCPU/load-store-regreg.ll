; RUN: llc -march=klausscpu -verify-machineinstrs -O1 < %s | FileCheck %s

; Register-offset (MODE=11, EA = base + index) loads and stores at every width:
; one 1-word LDIDXnR / LDIDXn_SR / STIDXnR instead of ADDR + MEMGETn / MEMSETn.
; An immediate offset that fits simm32 keeps the base+imm LDIDXn / STIDXn form,
; and an under-aligned access is still split into byte accesses (the 16/32-bit
; register-offset forms force-align their EA).

target triple = "klausscpu-unknown-elf"

define i64 @zext_i8(ptr %p, i64 %i) nounwind {
; CHECK-LABEL: zext_i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx8r r12, r0, r1
; CHECK-NEXT:    leaveret
  %a = getelementptr i8, ptr %p, i64 %i
  %v = load i8, ptr %a
  %r = zext i8 %v to i64
  ret i64 %r
}

define i64 @sext_i8(ptr %p, i64 %i) nounwind {
; CHECK-LABEL: sext_i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx8sr r12, r0, r1
; CHECK-NEXT:    leaveret
  %a = getelementptr i8, ptr %p, i64 %i
  %v = load i8, ptr %a
  %r = sext i8 %v to i64
  ret i64 %r
}

