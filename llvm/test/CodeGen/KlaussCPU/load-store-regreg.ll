; strlen-style byte loop: three instructions per byte.
define i64 @slen(ptr %s) nounwind {
; CHECK-LABEL: slen:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    setr r14, 0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB12_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldidx8r r13, r0, r14
; CHECK-NEXT:    copy r12, r14
; CHECK-NEXT:    incr r14, r14
; CHECK-NEXT:    fbri r13, 0, 8, .LBB12_1
; CHECK-NEXT:  # %bb.2: # %done
; CHECK-NEXT:    leaveret
entry:
  br label %loop
loop:
  %n = phi i64 [ 0, %entry ], [ %n1, %loop ]
  %a = getelementptr i8, ptr %s, i64 %n
  %c = load i8, ptr %a
  %n1 = add i64 %n, 1
  %z = icmp eq i8 %c, 0
  br i1 %z, label %done, label %loop
done:
  ret i64 %n
}

; A simm32 offset stays base + immediate.
define i64 @imm_offset(ptr %p) nounwind {
; CHECK-LABEL: imm_offset:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx8 r12, r0, 100
; CHECK-NEXT:    leaveret
  %a = getelementptr i8, ptr %p, i64 100
  %v = load i8, ptr %a
  %r = zext i8 %v to i64
  ret i64 %r
}

; An offset beyond simm32 is materialized and used as the index register.
define void @big_offset(ptr %p, i64 %v) nounwind {
; CHECK-LABEL: big_offset:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    setr64 r12, 0, 1
; CHECK-NEXT:    stidx16r r1, r0, r12
; CHECK-NEXT:    leaveret
  %a = getelementptr i8, ptr %p, i64 4294967296
  %t = trunc i64 %v to i16
  store i16 %t, ptr %a
  ret void
}

; A local array indexed by a register.
define i64 @local_array(i64 %i) nounwind {
; CHECK-LABEL: local_array:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 9
; CHECK-NEXT:    stidx64 r5, r15, -16 # 8-byte Folded Spill
; CHECK-NEXT:    addi r5, r15, -48
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r0
; CHECK-NEXT:    copy r0, r5
; CHECK-NEXT:    call fill
; CHECK-NEXT:    shlv r12, r4, 1
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    ldidx16sr r12, r5, r12
; CHECK-NEXT:    ldidx64 r5, r15, -16 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
  %buf = alloca [16 x i16], align 2
  call void @fill(ptr %buf)
  %a = getelementptr [16 x i16], ptr %buf, i64 0, i64 %i
  %v = load i16, ptr %a
  %r = sext i16 %v to i64
  ret i64 %r
}
declare void @fill(ptr)

; Under-aligned: never the force-aligned register-offset form.
define i64 @unaligned_i32(ptr %p, i64 %i) nounwind {
; CHECK-LABEL: unaligned_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    addr r12, r0, r1
; CHECK-NEXT:    ldidx8r r14, r0, r1
; CHECK-NEXT:    ldidx8 r13, r12, 1
; CHECK-NEXT:    ldidx8 r11, r12, 2
; CHECK-NEXT:    ldidx8 r12, r12, 3
; CHECK-NEXT:    shlv r13, r13, 8
; CHECK-NEXT:    shlv r11, r11, 16
; CHECK-NEXT:    shlv r12, r12, 24
; CHECK-NEXT:    orr r14, r13, r14
; CHECK-NEXT:    orr r12, r12, r11
; CHECK-NEXT:    orr r12, r12, r14
; CHECK-NEXT:    leaveret
  %a = getelementptr i8, ptr %p, i64 %i
  %v = load i32, ptr %a, align 1
  %r = zext i32 %v to i64
  ret i64 %r
}

define void @unaligned_store_i16(ptr %p, i64 %i, i16 %v) nounwind {
; CHECK-LABEL: unaligned_store_i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    addr r12, r0, r1
; CHECK-NEXT:    shrv r14, r2, 8
; CHECK-NEXT:    stidx8r r2, r0, r1
; CHECK-NEXT:    stidx8 r14, r12, 1
; CHECK-NEXT:    leaveret
