; Stack realignment.  The ABI stack is 8-byte aligned, so R15 is only 8-byte
; aligned; a local aligned above that must be addressed from the base pointer
; R7 = R15 & -MaxAlign, set up after the callee-saved spills (which save the
; caller's R7) in a frame enlarged by MaxAlign-8.  The callee-saved slots and
; the incoming arguments stay R15-relative.  Without realignment the locals
; were R15-relative at only 8-byte alignment, and the two halves of an i128
; local could share a slot (the DAG folds FI+8 into FI|8 for a 16-aligned FI).

declare void @use(ptr)
declare i128 @mk()

; An _Alignas(32) local.
define void @align32() nounwind {
; CHECK-LABEL: align32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 15
; CHECK-NEXT:    stidx64 r7, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    andi r7, r15, -32
; CHECK-NEXT:    addi r0, r7, -64
; CHECK-NEXT:    call use
; CHECK-NEXT:    ldidx64 r7, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
;
; PUSH-LABEL: align32:
; PUSH:       # %bb.0:
; PUSH-NEXT:    push r15
; PUSH-NEXT:    getsp r15
; PUSH-NEXT:    addsp -120
; PUSH-NEXT:    stidx64 r7, r15, -8 # 8-byte Folded Spill
; PUSH-NEXT:    andi r7, r15, -32
; PUSH-NEXT:    addi r0, r7, -64
; PUSH-NEXT:    call use
; PUSH-NEXT:    ldidx64 r7, r15, -8 # 8-byte Folded Reload
; PUSH-NEXT:    setsp r15
; PUSH-NEXT:    pop r15
; PUSH-NEXT:    ret
  %b = alloca [40 x i8], align 32
  call void @use(ptr %b)
  ret void
}

