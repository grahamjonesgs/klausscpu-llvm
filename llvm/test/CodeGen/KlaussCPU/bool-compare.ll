; A compare whose 0/1 result is a value (no branch): the class 3 boolean
; compares.  A simm32 constant takes the 2-word immediate form (CMPxxV), not
; SETR + CMPxxR; a compare of 32-bit values whose extensions then die takes
; the ISA v3 D2 W form (CMPxxRW / CMPxxVW).

define i64 @eq_imm(i64 %a) nounwind {
; CHECK-LABEL: eq_imm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    cmpeqv r12, r0, 1000
; CHECK-NEXT:    leaveret
  %c = icmp eq i64 %a, 1000
  %r = zext i1 %c to i64
  ret i64 %r
}

