; RUN: llc -march=klausscpu -verify-machineinstrs -O1 < %s | FileCheck %s

; Forced atomics: every atomicrmw of 1, 2, 4 or 8 bytes is a call to the
; __sync_* libcall of its size (xchg is __sync_lock_test_and_set_N), which
; the runtime implements with interrupts masked (src/atomic.c).  The value
; argument of a sub-word op is passed any-extended; the result comes back
; zero-extended (getExtendForAtomicOps), so a zext of it is free and a sext
; is an explicit extension.

define i8 @xchg_i8(ptr %p, i8 %x) nounwind {
; CHECK-LABEL: xchg_i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 3
; CHECK-NEXT:    callrel __sync_lock_test_and_set_1
; CHECK-NEXT:    leaveret
  %v = atomicrmw xchg ptr %p, i8 %x seq_cst
  ret i8 %v
}

