; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=klausscpu -verify-machineinstrs -O2 < %s | FileCheck %s
; RUN: llc -mtriple=klausscpu -verify-machineinstrs -O2 \
; RUN:   -klausscpu-unaligned-load64=false < %s | FileCheck %s --check-prefix=NO64

; Under-aligned loads.  MEMGET32 ([r], mode 00, unsigned) is the only load
; that reads an unaligned word (CPU_ARCHITECTURE.md 8.3); LDIDX32 / LDIDX32R /
; LDIDX32_S align the address down and no 64-bit load reads an unaligned
; doubleword.  So an under-aligned i32 load is MEMGET32 of the computed
; address, never a base + offset or reg + reg form, and an under-aligned i64
; load is two 32-bit loads (KlaussCPUDAGToDAGISel::PreprocessISelDAG), which
; lets the combiner build one from 8 byte loads (-klausscpu-unaligned-load64).

%packed = type <{ i8, i32, i32, i64, i16 }>

; A packed struct field: ADDI + MEMGET32, not LDIDX32 base, 1.
define i64 @packed_u32(ptr %p) nounwind {
; CHECK-LABEL: packed_u32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    incr r12, r0
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    ret
;
; NO64-LABEL: packed_u32:
; NO64:       # %bb.0:
; NO64-NEXT:    incr r12, r0
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    ret
  %a = getelementptr inbounds %packed, ptr %p, i64 0, i32 1
  %v = load i32, ptr %a, align 1
  %z = zext i32 %v to i64
  ret i64 %z
}

; An array of packed structs: ADDR + MEMGET32, not LDIDX32R.
define i64 @packed_u32_index(ptr %p, i64 %i) nounwind {
; CHECK-LABEL: packed_u32_index:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mulv r12, r1, 19
; CHECK-NEXT:    addr r12, r0, r12
; CHECK-NEXT:    incr r12, r12
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    ret
;
; NO64-LABEL: packed_u32_index:
; NO64:       # %bb.0:
; NO64-NEXT:    mulv r12, r1, 19
; NO64-NEXT:    addr r12, r0, r12
; NO64-NEXT:    incr r12, r12
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    ret
  %a = getelementptr inbounds %packed, ptr %p, i64 %i, i32 1
  %v = load i32, ptr %a, align 1
  %z = zext i32 %v to i64
  ret i64 %z
}

; A sign-extending one: MEMGET32 has no SGN form, so SEXTW, not LDIDX32_SR.
define i64 @u32_index_sext(ptr %p, i64 %i) nounwind {
; CHECK-LABEL: u32_index_sext:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addr r12, r0, r1
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    sextw r12, r12
; CHECK-NEXT:    ret
;
; NO64-LABEL: u32_index_sext:
; NO64:       # %bb.0:
; NO64-NEXT:    addr r12, r0, r1
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    sextw r12, r12
; NO64-NEXT:    ret
  %a = getelementptr inbounds i8, ptr %p, i64 %i
  %v = load i32, ptr %a, align 2
  %s = sext i32 %v to i64
  ret i64 %s
}

; An i64 field below 4-byte alignment: two MEMGET32, the high half at
; p + (9 + 4) directly.
define i64 @packed_u64(ptr %p) nounwind {
; CHECK-LABEL: packed_u64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi r12, r0, 13
; CHECK-NEXT:    addi r14, r0, 9
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    memget32 r14, r14
; CHECK-NEXT:    shlv r12, r12, 32
; CHECK-NEXT:    orr r12, r12, r14
; CHECK-NEXT:    ret
;
; NO64-LABEL: packed_u64:
; NO64:       # %bb.0:
; NO64-NEXT:    addi r12, r0, 13
; NO64-NEXT:    addi r14, r0, 9
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    memget32 r14, r14
; NO64-NEXT:    shlv r12, r12, 32
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    ret
  %a = getelementptr inbounds %packed, ptr %p, i64 0, i32 3
  %v = load i64, ptr %a, align 1
  ret i64 %v
}

; At 4-byte alignment the halves are aligned: two LDIDX32.
define i64 @u64_align4(ptr %p) nounwind {
; CHECK-LABEL: u64_align4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    ldidx32 r12, r0, 12
; CHECK-NEXT:    ldidx32 r14, r0, 8
; CHECK-NEXT:    shlv r12, r12, 32
; CHECK-NEXT:    orr r12, r12, r14
; CHECK-NEXT:    ret
;
; NO64-LABEL: u64_align4:
; NO64:       # %bb.0:
; NO64-NEXT:    ldidx32 r12, r0, 12
; NO64-NEXT:    ldidx32 r14, r0, 8
; NO64-NEXT:    shlv r12, r12, 32
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    ret
  %a = getelementptr inbounds i8, ptr %p, i64 8
  %v = load i64, ptr %a, align 4
  ret i64 %v
}

; reg + reg: ADDR, then two MEMGET32, not LDIDX64R.
define i64 @u64_index(ptr %p, i64 %i) nounwind {
; CHECK-LABEL: u64_index:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addr r12, r0, r1
; CHECK-NEXT:    addi r14, r12, 4
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    memget32 r14, r14
; CHECK-NEXT:    shlv r14, r14, 32
; CHECK-NEXT:    orr r12, r14, r12
; CHECK-NEXT:    ret
;
; NO64-LABEL: u64_index:
; NO64:       # %bb.0:
; NO64-NEXT:    addr r12, r0, r1
; NO64-NEXT:    addi r14, r12, 4
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    memget32 r14, r14
; NO64-NEXT:    shlv r14, r14, 32
; NO64-NEXT:    orr r12, r14, r12
; NO64-NEXT:    ret
  %a = getelementptr inbounds i8, ptr %p, i64 %i
  %v = load i64, ptr %a, align 1
  ret i64 %v
}

; A packed local: frame address + MEMGET32.
define i64 @packed_frame() nounwind {
; CHECK-LABEL: packed_frame:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 3
; CHECK-NEXT:    addi r0, r15, -19
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    addi r12, r15, -6
; CHECK-NEXT:    addi r14, r15, -10
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    memget32 r14, r14
; CHECK-NEXT:    shlv r12, r12, 32
; CHECK-NEXT:    orr r12, r12, r14
; CHECK-NEXT:    leaveret
;
; NO64-LABEL: packed_frame:
; NO64:       # %bb.0:
; NO64-NEXT:    enter 3
; NO64-NEXT:    addi r0, r15, -19
; NO64-NEXT:    callrel use
; NO64-NEXT:    addi r12, r15, -6
; NO64-NEXT:    addi r14, r15, -10
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    memget32 r14, r14
; NO64-NEXT:    shlv r12, r12, 32
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    leaveret
  %s = alloca %packed, align 1
  call void @use(ptr %s)
  %a = getelementptr inbounds %packed, ptr %s, i64 0, i32 3
  %v = load i64, ptr %a, align 1
  ret i64 %v
}

; 8 bytes assembled little-endian: one i64 load (two MEMGET32) instead of
; one MEMGET32 + 4 byte loads + 4 shifts + 4 ORs.
define i64 @le64(ptr %p) nounwind {
; CHECK-LABEL: le64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi r12, r0, 4
; CHECK-NEXT:    memget32 r14, r0
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    shlv r12, r12, 32
; CHECK-NEXT:    orr r12, r12, r14
; CHECK-NEXT:    ret
;
; NO64-LABEL: le64:
; NO64:       # %bb.0:
; NO64-NEXT:    ldidx8 r12, r0, 4
; NO64-NEXT:    ldidx8 r14, r0, 5
; NO64-NEXT:    memget32 r13, r0
; NO64-NEXT:    shlv r12, r12, 32
; NO64-NEXT:    ldidx8 r11, r0, 6
; NO64-NEXT:    orr r12, r13, r12
; NO64-NEXT:    shlv r14, r14, 40
; NO64-NEXT:    ldidx8 r10, r0, 7
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    shlv r13, r11, 48
; NO64-NEXT:    shlv r14, r10, 56
; NO64-NEXT:    orr r12, r12, r13
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    ret
  %b0 = load i8, ptr %p, align 1
  %z0 = zext i8 %b0 to i64
  %s0 = shl i64 %z0, 0
  %a1 = getelementptr inbounds i8, ptr %p, i64 1
  %b1 = load i8, ptr %a1, align 1
  %z1 = zext i8 %b1 to i64
  %s1 = shl i64 %z1, 8
  %a2 = getelementptr inbounds i8, ptr %p, i64 2
  %b2 = load i8, ptr %a2, align 1
  %z2 = zext i8 %b2 to i64
  %s2 = shl i64 %z2, 16
  %a3 = getelementptr inbounds i8, ptr %p, i64 3
  %b3 = load i8, ptr %a3, align 1
  %z3 = zext i8 %b3 to i64
  %s3 = shl i64 %z3, 24
  %a4 = getelementptr inbounds i8, ptr %p, i64 4
  %b4 = load i8, ptr %a4, align 1
  %z4 = zext i8 %b4 to i64
  %s4 = shl i64 %z4, 32
  %a5 = getelementptr inbounds i8, ptr %p, i64 5
  %b5 = load i8, ptr %a5, align 1
  %z5 = zext i8 %b5 to i64
  %s5 = shl i64 %z5, 40
  %a6 = getelementptr inbounds i8, ptr %p, i64 6
  %b6 = load i8, ptr %a6, align 1
  %z6 = zext i8 %b6 to i64
  %s6 = shl i64 %z6, 48
  %a7 = getelementptr inbounds i8, ptr %p, i64 7
  %b7 = load i8, ptr %a7, align 1
  %z7 = zext i8 %b7 to i64
  %s7 = shl i64 %z7, 56
  %o1 = or i64 %s0, %s1
  %o2 = or i64 %o1, %s2
  %o3 = or i64 %o2, %s3
  %o4 = or i64 %o3, %s4
  %o5 = or i64 %o4, %s5
  %o6 = or i64 %o5, %s6
  %o7 = or i64 %o6, %s7
  ret i64 %o7
}

; Big-endian (network order): the same + BSWAP.
define i64 @be64(ptr %p) nounwind {
; CHECK-LABEL: be64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi r12, r0, 4
; CHECK-NEXT:    memget32 r14, r0
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    shlv r12, r12, 32
; CHECK-NEXT:    orr r12, r12, r14
; CHECK-NEXT:    bswap r12, r12
; CHECK-NEXT:    ret
;
; NO64-LABEL: be64:
; NO64:       # %bb.0:
; NO64-NEXT:    memget8 r12, r0
; NO64-NEXT:    ldidx8 r14, r0, 1
; NO64-NEXT:    ldidx8 r13, r0, 2
; NO64-NEXT:    shlv r12, r12, 56
; NO64-NEXT:    shlv r14, r14, 48
; NO64-NEXT:    ldidx8 r11, r0, 3
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    shlv r13, r13, 40
; NO64-NEXT:    ldidx8 r10, r0, 4
; NO64-NEXT:    orr r12, r12, r13
; NO64-NEXT:    shlv r11, r11, 32
; NO64-NEXT:    ldidx8 r14, r0, 5
; NO64-NEXT:    shlv r10, r10, 24
; NO64-NEXT:    orr r12, r12, r11
; NO64-NEXT:    ldidx8 r13, r0, 6
; NO64-NEXT:    shlv r14, r14, 16
; NO64-NEXT:    orr r12, r12, r10
; NO64-NEXT:    shlv r13, r13, 8
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    ldidx8 r14, r0, 7
; NO64-NEXT:    orr r12, r12, r13
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    ret
  %b0 = load i8, ptr %p, align 1
  %z0 = zext i8 %b0 to i64
  %s0 = shl i64 %z0, 56
  %a1 = getelementptr inbounds i8, ptr %p, i64 1
  %b1 = load i8, ptr %a1, align 1
  %z1 = zext i8 %b1 to i64
  %s1 = shl i64 %z1, 48
  %a2 = getelementptr inbounds i8, ptr %p, i64 2
  %b2 = load i8, ptr %a2, align 1
  %z2 = zext i8 %b2 to i64
  %s2 = shl i64 %z2, 40
  %a3 = getelementptr inbounds i8, ptr %p, i64 3
  %b3 = load i8, ptr %a3, align 1
  %z3 = zext i8 %b3 to i64
  %s3 = shl i64 %z3, 32
  %a4 = getelementptr inbounds i8, ptr %p, i64 4
  %b4 = load i8, ptr %a4, align 1
  %z4 = zext i8 %b4 to i64
  %s4 = shl i64 %z4, 24
  %a5 = getelementptr inbounds i8, ptr %p, i64 5
  %b5 = load i8, ptr %a5, align 1
  %z5 = zext i8 %b5 to i64
  %s5 = shl i64 %z5, 16
  %a6 = getelementptr inbounds i8, ptr %p, i64 6
  %b6 = load i8, ptr %a6, align 1
  %z6 = zext i8 %b6 to i64
  %s6 = shl i64 %z6, 8
  %a7 = getelementptr inbounds i8, ptr %p, i64 7
  %b7 = load i8, ptr %a7, align 1
  %z7 = zext i8 %b7 to i64
  %s7 = shl i64 %z7, 0
  %o1 = or i64 %s0, %s1
  %o2 = or i64 %o1, %s2
  %o3 = or i64 %o2, %s3
  %o4 = or i64 %o3, %s4
  %o5 = or i64 %o4, %s5
  %o6 = or i64 %o5, %s6
  %o7 = or i64 %o6, %s7
  ret i64 %o7
}

; An under-aligned i64 copied to an 8-aligned place (memcpy(d, s, 8) after
; InstCombine): SHLV + ORR + STIDX64 (0.5 cycles per 8 bytes faster on the
; board than two 32-bit copies), two copies when optimising for size.
define void @copy64(ptr align 8 %d, ptr %s) nounwind {
; CHECK-LABEL: copy64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi r12, r1, 4
; CHECK-NEXT:    memget32 r14, r1
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    shlv r12, r12, 32
; CHECK-NEXT:    orr r12, r12, r14
; CHECK-NEXT:    stidx64 r12, r0, 0
; CHECK-NEXT:    ret
;
; NO64-LABEL: copy64:
; NO64:       # %bb.0:
; NO64-NEXT:    addi r12, r1, 4
; NO64-NEXT:    memget32 r14, r1
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    shlv r12, r12, 32
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    stidx64 r12, r0, 0
; NO64-NEXT:    ret
  %v = load i64, ptr %s, align 1
  store i64 %v, ptr %d, align 8
  ret void
}

define void @copy64_optsize(ptr align 8 %d, ptr %s) nounwind optsize {
; CHECK-LABEL: copy64_optsize:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi r12, r1, 4
; CHECK-NEXT:    memget32 r14, r1
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    memset32 r14, r0
; CHECK-NEXT:    stidx32 r12, r0, 4
; CHECK-NEXT:    ret
;
; NO64-LABEL: copy64_optsize:
; NO64:       # %bb.0:
; NO64-NEXT:    addi r12, r1, 4
; NO64-NEXT:    memget32 r14, r1
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    shlv r12, r12, 32
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    stidx64 r12, r0, 0
; NO64-NEXT:    ret
  %v = load i64, ptr %s, align 1
  store i64 %v, ptr %d, align 8
  ret void
}

; At 4-byte alignment: two LDIDX32.
define void @copy64_align4(ptr align 8 %d, ptr %s) nounwind {
; CHECK-LABEL: copy64_align4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    ldidx32 r12, r1, 4
; CHECK-NEXT:    memget32 r14, r1
; CHECK-NEXT:    shlv r12, r12, 32
; CHECK-NEXT:    orr r12, r12, r14
; CHECK-NEXT:    stidx64 r12, r0, 0
; CHECK-NEXT:    ret
;
; NO64-LABEL: copy64_align4:
; NO64:       # %bb.0:
; NO64-NEXT:    ldidx32 r12, r1, 4
; NO64-NEXT:    memget32 r14, r1
; NO64-NEXT:    shlv r12, r12, 32
; NO64-NEXT:    orr r12, r12, r14
; NO64-NEXT:    stidx64 r12, r0, 0
; NO64-NEXT:    ret
  %v = load i64, ptr %s, align 4
  store i64 %v, ptr %d, align 8
  ret void
}

; Store merging joins two 32-bit copies with the halves swapped into an i64
; copy (rotl 32); a ROLV would cost 2 cycles more, so they stay two copies.
define void @copy64_swapped(ptr align 8 %d, ptr %s) nounwind {
; CHECK-LABEL: copy64_swapped:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi r12, r1, 4
; CHECK-NEXT:    memget32 r14, r1
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    stidx32 r14, r0, 4
; CHECK-NEXT:    memset32 r12, r0
; CHECK-NEXT:    ret
;
; NO64-LABEL: copy64_swapped:
; NO64:       # %bb.0:
; NO64-NEXT:    addi r12, r1, 4
; NO64-NEXT:    memget32 r14, r1
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    memset32 r12, r0
; NO64-NEXT:    stidx32 r14, r0, 4
; NO64-NEXT:    ret
  %s4 = getelementptr inbounds i8, ptr %s, i64 4
  %lo = load i32, ptr %s, align 1
  %hi = load i32, ptr %s4, align 1
  %d4 = getelementptr inbounds i8, ptr %d, i64 4
  store i32 %hi, ptr %d, align 8
  store i32 %lo, ptr %d4, align 4
  ret void
}

; Copied to a 4-aligned place (the legalizer splits the store): two 32-bit
; copies, not the joined value shifted apart again.
define void @copy64_to_align4(ptr align 4 %d, ptr %s) nounwind {
; CHECK-LABEL: copy64_to_align4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi r12, r1, 4
; CHECK-NEXT:    memget32 r14, r1
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    memset32 r14, r0
; CHECK-NEXT:    stidx32 r12, r0, 4
; CHECK-NEXT:    ret
;
; NO64-LABEL: copy64_to_align4:
; NO64:       # %bb.0:
; NO64-NEXT:    addi r12, r1, 4
; NO64-NEXT:    memget32 r14, r1
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    memset32 r14, r0
; NO64-NEXT:    stidx32 r12, r0, 4
; NO64-NEXT:    ret
  %v = load i64, ptr %s, align 1
  store i64 %v, ptr %d, align 4
  ret void
}

; Only the high half is used: one MEMGET32.
define i64 @u64_high(ptr %p) nounwind {
; CHECK-LABEL: u64_high:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi r12, r0, 4
; CHECK-NEXT:    memget32 r12, r12
; CHECK-NEXT:    ret
;
; NO64-LABEL: u64_high:
; NO64:       # %bb.0:
; NO64-NEXT:    addi r12, r0, 4
; NO64-NEXT:    memget32 r12, r12
; NO64-NEXT:    ret
  %v = load i64, ptr %p, align 1
  %h = lshr i64 %v, 32
  ret i64 %h
}

