; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -march=klausscpu -verify-machineinstrs -O1 < %s | FileCheck %s
;
; A branch on a 32-bit compare.  tryW32Compare takes the W compare
; (CMPRRW/CMPRVW) for a branch as for a select or a value, and
; KlaussCPUFuseCmpBr fuses it into an FBR with a W predicate (EQW/LTW/ULTW,
; klaussCPU 3508f87), so the operands' sign extensions go and their add,
; subtract or multiply needs no W form; before 3508f87 the branch compared
; 64 bits so that it could fuse, and the extension became the W op.

; Zephyr mandel's loop test (`n++ < maxit`, unsigned), with n's value
; stored only in its low 32 bits: INCR + a W FBR (ULTW), no extension.
define void @count_u32_store(i32 signext %max, ptr %p) nounwind {
; CHECK-LABEL: count_u32_store:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    incr r14, r12
; CHECK-NEXT:    memset32 r12, r1
; CHECK-NEXT:    copy r12, r14
; CHECK-NEXT:    fbr r14, r0, 7, .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %n = phi i32 [ 0, %entry ], [ %n.next, %loop ]
  %n.next = add i32 %n, 1
  store volatile i32 %n, ptr %p
  %c = icmp ult i32 %n.next, %max
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

; The same loop returning n: the signext return needs the extension, so the
; add is ADDIW, and the branch still takes the W compare.
define signext i32 @count_u32(i32 signext %max, ptr %p) nounwind {
; CHECK-LABEL: count_u32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB1_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    copy r14, r12
; CHECK-NEXT:    addiw r12, r12, 1
; CHECK-NEXT:    memset32 r14, r1
; CHECK-NEXT:    fbr r12, r0, 7, .LBB1_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %n = phi i32 [ 0, %entry ], [ %n.next, %loop ]
  %n.next = add i32 %n, 1
  store volatile i32 %n, ptr %p
  %c = icmp ult i32 %n.next, %max
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %n.next
}

; A signed down-counter compared with a register, returned: the extension
; is needed (ADDIW) and does not die, so the compare stays 64-bit.
define signext i32 @down_s32(i32 signext %n, i32 signext %lim, ptr %p) nounwind {
; CHECK-LABEL: down_s32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB2_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    memset32 r0, r2
; CHECK-NEXT:    addiw r0, r0, -3
; CHECK-NEXT:    fbr r0, r1, 10, .LBB2_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    copy r12, r0
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i32 [ %n, %entry ], [ %i.next, %loop ]
  store volatile i32 %i, ptr %p
  %i.next = sub i32 %i, 3
  %c = icmp sgt i32 %i.next, %lim
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %i.next
}

; The add's result is also passed, unextended, to a call, which reads the
; whole register: rule 4 cannot make the add ADDIW, so its SEXTW stays, and
; with a reader other than the compare (the ZEXTW) the compare of the
; SEXTW is 64-bit; it fuses either way.
declare void @use(i32)

define i64 @wide_reader(i32 %a, i32 signext %b, ptr %p) nounwind {
;
; CHECK-LABEL: wide_reader:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    enter 3
; CHECK-NEXT:    addi r0, r0, 7
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    stidx64 r5, r15, -16 # 8-byte Folded Spill
; CHECK-NEXT:    stidx64 r6, r15, -24 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r2
; CHECK-NEXT:    copy r5, r1
; CHECK-NEXT:    sextw r6, r0
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    fbr r6, r5, 9, .LBB3_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    zextw r12, r6
; CHECK-NEXT:    ldidx64r r12, r4, r12
; CHECK-NEXT:    jmprel .LBB3_3
; CHECK-NEXT:  .LBB3_2: # %f
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:  .LBB3_3: # %f
; CHECK-NEXT:    ldidx64 r6, r15, -24 # 8-byte Folded Reload
; CHECK-NEXT:    ldidx64 r5, r15, -16 # 8-byte Folded Reload
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
entry:
  %s = add i32 %a, 7
  call void @use(i32 %s)
  %c = icmp slt i32 %s, %b
  br i1 %c, label %t, label %f
t:
  %z = zext i32 %s to i64
  %q = getelementptr i8, ptr %p, i64 %z
  %v = load i64, ptr %q
  ret i64 %v
f:
  ret i64 0
}

; A compare of a PHI with a constant outside simm4: the W compare, fused
; into the 2-word FBR_RV (ULTW, UGEW).
define signext i32 @phi_cmp(i32 signext %a, i32 signext %b, i1 %k) nounwind {
; CHECK-LABEL: phi_cmp:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    andv r12, r2, 1
; CHECK-NEXT:    fbri r12, 0, 0, .LBB4_2
; CHECK-NEXT:  # %bb.1: # %x
; CHECK-NEXT:    addi r12, r0, 5
; CHECK-NEXT:    fbrv r12, 100000, 7, .LBB4_4
; CHECK-NEXT:  .LBB4_5: # %f
; CHECK-NEXT:    sextw r12, r12
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB4_2: # %y
; CHECK-NEXT:    mulr r12, r1, r0
; CHECK-NEXT:    fbrv r12, 100000, 15, .LBB4_5
; CHECK-NEXT:  .LBB4_4: # %t
; CHECK-NEXT:    setr r12, 1
; CHECK-NEXT:    ret
entry:
  br i1 %k, label %x, label %y
x:
  %a1 = add i32 %a, 5
  br label %j
y:
  %b1 = mul i32 %b, %a
  br label %j
j:
  %v = phi i32 [ %a1, %x ], [ %b1, %y ]
  %c = icmp ult i32 %v, 100000
  br i1 %c, label %t, label %f
t:
  ret i32 1
f:
  ret i32 %v
}
