; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -march=klausscpu -verify-machineinstrs -O1 < %s | FileCheck %s
; RUN: llc -march=klausscpu -verify-machineinstrs -O1 \
; RUN:   -klausscpu-w32-compare-branch=true < %s | FileCheck %s --check-prefix=WCMP
;
; A branch on a 32-bit compare.  FBR compares 64 bits (it has no width bit),
; so a W compare (CMPRRW/CMPRVW) stays a compare + JMPcc, with a FLAGS stall
; between them.  i32 compares promote by sign extension
; (isSExtCheaperThanZExt), and when each extension the W compare would drop
; is of an add, subtract or multiply, tryW32Compare compares 64 bits
; instead: the extension becomes the W op, through the W-op patterns or,
; when the op has other readers that read only its low 32 bits,
; KlaussCPUOptExtensions rule 4, and the branch fuses.
; -klausscpu-w32-compare-branch=true keeps the W compare.

; Zephyr mandel's loop test (`n++ < maxit`, unsigned): ADDIW + FBR, and the
; exit's SEXTW of n goes too.
define signext i32 @count_u32(i32 signext %max, ptr %p) nounwind {
;
; CHECK-LABEL: count_u32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    copy r14, r12
; CHECK-NEXT:    addiw r12, r12, 1
; CHECK-NEXT:    memset32 r14, r1
; CHECK-NEXT:    fbr r12, r0, 3, .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
;
; WCMP-LABEL: count_u32:
; WCMP:       # %bb.0: # %entry
; WCMP-NEXT:    setr r12, 0
; WCMP-NEXT:    .p2align 4
; WCMP-NEXT:  .LBB0_1: # %loop
; WCMP-NEXT:    # =>This Inner Loop Header: Depth=1
; WCMP-NEXT:    copy r14, r12
; WCMP-NEXT:    addiw r12, r12, 1
; WCMP-NEXT:    memset32 r14, r1
; WCMP-NEXT:    cmprrw r12, r0
; WCMP-NEXT:    jmpultrel .LBB0_1
; WCMP-NEXT:  # %bb.2: # %exit
; WCMP-NEXT:    ret
entry:
  br label %loop
loop:
  %n = phi i32 [ 0, %entry ], [ %n.next, %loop ]
  %n.next = add i32 %n, 1
  store volatile i32 %n, ptr %p
  %c = icmp ult i32 %n.next, %max
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %n.next
}

; A signed down-counter compared with a register: ADDIW + FBR.
define signext i32 @down_s32(i32 signext %n, i32 signext %lim, ptr %p) nounwind {
;
; CHECK-LABEL: down_s32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB1_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    memset32 r0, r2
; CHECK-NEXT:    addiw r0, r0, -3
; CHECK-NEXT:    fbr r0, r1, 10, .LBB1_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    copy r12, r0
; CHECK-NEXT:    ret
;
; WCMP-LABEL: down_s32:
; WCMP:       # %bb.0: # %entry
; WCMP-NEXT:    .p2align 4
; WCMP-NEXT:  .LBB1_1: # %loop
; WCMP-NEXT:    # =>This Inner Loop Header: Depth=1
; WCMP-NEXT:    memset32 r0, r2
; WCMP-NEXT:    addiw r0, r0, -3
; WCMP-NEXT:    fbr r0, r1, 10, .LBB1_1
; WCMP-NEXT:  # %bb.2: # %exit
; WCMP-NEXT:    copy r12, r0
; WCMP-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i32 [ %n, %entry ], [ %i.next, %loop ]
  store volatile i32 %i, ptr %p
  %i.next = sub i32 %i, 3
  %c = icmp sgt i32 %i.next, %lim
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %i.next
}

; The add's result is also passed, unextended, to a call, which reads the
; whole register: rule 4 cannot make the add ADDIW, so its SEXTW stays (and
; the compare, of the SEXTW, is still 64-bit and fuses).  Readers of only
; the low 32 bits (a ZEXTW, a 32-bit store) do not stop it.
declare void @use(i32)

define i64 @wide_reader(i32 %a, i32 signext %b, ptr %p) nounwind {
; CHECK-LABEL: wide_reader:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    enter 3
; CHECK-NEXT:    addi r0, r0, 7
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    stidx64 r5, r15, -16 # 8-byte Folded Spill
; CHECK-NEXT:    stidx64 r6, r15, -24 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r2
; CHECK-NEXT:    copy r5, r1
; CHECK-NEXT:    sextw r6, r0
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    fbr r6, r5, 9, .LBB2_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    zextw r12, r6
; CHECK-NEXT:    ldidx64r r12, r4, r12
; CHECK-NEXT:    jmprel .LBB2_3
; CHECK-NEXT:  .LBB2_2: # %f
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:  .LBB2_3: # %f
; CHECK-NEXT:    ldidx64 r6, r15, -24 # 8-byte Folded Reload
; CHECK-NEXT:    ldidx64 r5, r15, -16 # 8-byte Folded Reload
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
;
; WCMP-LABEL: wide_reader:
; WCMP:       # %bb.0: # %entry
; WCMP-NEXT:    enter 3
; WCMP-NEXT:    addi r0, r0, 7
; WCMP-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; WCMP-NEXT:    stidx64 r5, r15, -16 # 8-byte Folded Spill
; WCMP-NEXT:    stidx64 r6, r15, -24 # 8-byte Folded Spill
; WCMP-NEXT:    copy r4, r2
; WCMP-NEXT:    copy r5, r1
; WCMP-NEXT:    sextw r6, r0
; WCMP-NEXT:    callrel use
; WCMP-NEXT:    fbr r6, r5, 9, .LBB2_2
; WCMP-NEXT:  # %bb.1: # %t
; WCMP-NEXT:    zextw r12, r6
; WCMP-NEXT:    ldidx64r r12, r4, r12
; WCMP-NEXT:    jmprel .LBB2_3
; WCMP-NEXT:  .LBB2_2: # %f
; WCMP-NEXT:    setr r12, 0
; WCMP-NEXT:  .LBB2_3: # %f
; WCMP-NEXT:    ldidx64 r6, r15, -24 # 8-byte Folded Reload
; WCMP-NEXT:    ldidx64 r5, r15, -16 # 8-byte Folded Reload
; WCMP-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; WCMP-NEXT:    leaveret
entry:
  %s = add i32 %a, 7
  call void @use(i32 %s)
  %c = icmp slt i32 %s, %b
  br i1 %c, label %t, label %f
t:
  %z = zext i32 %s to i64
  %q = getelementptr i8, ptr %p, i64 %z
  %v = load i64, ptr %q
  ret i64 %v
f:
  ret i64 0
}

; A compare of a PHI keeps the W compare: SEXTW + FBR would be no shorter.
define signext i32 @phi_cmp(i32 signext %a, i32 signext %b, i1 %k) nounwind {
;
; CHECK-LABEL: phi_cmp:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    andv r12, r2, 1
; CHECK-NEXT:    fbri r12, 0, 0, .LBB3_2
; CHECK-NEXT:  # %bb.1: # %x
; CHECK-NEXT:    addi r12, r0, 5
; CHECK-NEXT:    cmprvw r12, 99999
; CHECK-NEXT:    jmpulerel .LBB3_4
; CHECK-NEXT:  .LBB3_5: # %f
; CHECK-NEXT:    sextw r12, r12
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB3_2: # %y
; CHECK-NEXT:    mulr r12, r1, r0
; CHECK-NEXT:    cmprvw r12, 99999
; CHECK-NEXT:    jmpugtrel .LBB3_5
; CHECK-NEXT:  .LBB3_4: # %t
; CHECK-NEXT:    setr r12, 1
; CHECK-NEXT:    ret
;
; WCMP-LABEL: phi_cmp:
; WCMP:       # %bb.0: # %entry
; WCMP-NEXT:    andv r12, r2, 1
; WCMP-NEXT:    fbri r12, 0, 0, .LBB3_2
; WCMP-NEXT:  # %bb.1: # %x
; WCMP-NEXT:    addi r12, r0, 5
; WCMP-NEXT:    cmprvw r12, 99999
; WCMP-NEXT:    jmpulerel .LBB3_4
; WCMP-NEXT:  .LBB3_5: # %f
; WCMP-NEXT:    sextw r12, r12
; WCMP-NEXT:    ret
; WCMP-NEXT:  .LBB3_2: # %y
; WCMP-NEXT:    mulr r12, r1, r0
; WCMP-NEXT:    cmprvw r12, 99999
; WCMP-NEXT:    jmpugtrel .LBB3_5
; WCMP-NEXT:  .LBB3_4: # %t
; WCMP-NEXT:    setr r12, 1
; WCMP-NEXT:    ret
entry:
  br i1 %k, label %x, label %y
x:
  %a1 = add i32 %a, 5
  br label %j
y:
  %b1 = mul i32 %b, %a
  br label %j
j:
  %v = phi i32 [ %a1, %x ], [ %b1, %y ]
  %c = icmp ult i32 %v, 100000
  br i1 %c, label %t, label %f
t:
  ret i32 1
f:
  ret i32 %v
}
