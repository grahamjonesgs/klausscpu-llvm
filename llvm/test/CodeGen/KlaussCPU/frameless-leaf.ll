; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=klausscpu -verify-machineinstrs -O1 < %s | FileCheck %s
; RUN: llc -mtriple=klausscpu -verify-machineinstrs -O1 \
; RUN:   -klausscpu-frameless-leaf=false < %s | FileCheck %s --check-prefix=FRAME
;
; A leaf function without stack objects has no frame: no ENTER, and a plain
; RET (CALL leaves the return address at [SP] and R15 alone).  R15 keeps the
; caller's frame.  Anything that needs the frame, or a "frame-pointer"
; attribute that asks for one, keeps ENTER / LEAVERET.  A frameless leaf
; needs no CFI beyond the CIE's (CFA = SP+8): DebugInfo/KlaussCPU/frame-cfi.ll.

define i64 @leaf(i64 %a, i64 %b) {
; CHECK-LABEL: leaf:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addr r12, r0, r1
; CHECK-NEXT:    ret
;
; FRAME-LABEL: leaf:
; FRAME:       # %bb.0:
; FRAME-NEXT:    enter 0
; FRAME-NEXT:    .cfi_def_cfa r15, 16
; FRAME-NEXT:    .cfi_offset r15, -16
; FRAME-NEXT:    addr r12, r0, r1
; FRAME-NEXT:    leaveret
  %r = add i64 %a, %b
  ret i64 %r
}

; "frame-pointer"="all" (clang -mno-omit-leaf-frame-pointer) keeps the frame.
define i64 @leaf_fp_all(i64 %a, i64 %b) nounwind "frame-pointer"="all" {
; CHECK-LABEL: leaf_fp_all:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    addr r12, r0, r1
; CHECK-NEXT:    leaveret
;
; FRAME-LABEL: leaf_fp_all:
; FRAME:       # %bb.0:
; FRAME-NEXT:    enter 0
; FRAME-NEXT:    addr r12, r0, r1
; FRAME-NEXT:    leaveret
  %r = add i64 %a, %b
  ret i64 %r
}

; clang's default: "non-leaf" asks for a frame only where there is a call.
define i64 @leaf_fp_nonleaf(i64 %a, i64 %b) nounwind "frame-pointer"="non-leaf" {
; CHECK-LABEL: leaf_fp_nonleaf:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addr r12, r0, r1
; CHECK-NEXT:    ret
;
; FRAME-LABEL: leaf_fp_nonleaf:
; FRAME:       # %bb.0:
; FRAME-NEXT:    enter 0
; FRAME-NEXT:    addr r12, r0, r1
; FRAME-NEXT:    leaveret
  %r = add i64 %a, %b
  ret i64 %r
}

; A local: R15-relative, so a frame.
define i64 @leaf_local(i64 %a) nounwind {
; CHECK-LABEL: leaf_local:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 1
; CHECK-NEXT:    stidx64 r0, r15, -8
; CHECK-NEXT:    addi r12, r15, -8
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    ldidx64 r12, r15, -8
; CHECK-NEXT:    leaveret
;
; FRAME-LABEL: leaf_local:
; FRAME:       # %bb.0:
; FRAME-NEXT:    enter 1
; FRAME-NEXT:    stidx64 r0, r15, -8
; FRAME-NEXT:    addi r12, r15, -8
; FRAME-NEXT:    #APP
; FRAME-NEXT:    #NO_APP
; FRAME-NEXT:    ldidx64 r12, r15, -8
; FRAME-NEXT:    leaveret
  %p = alloca i64
  store i64 %a, ptr %p
  call void asm sideeffect "", "r,~{memory}"(ptr %p)
  %v = load i64, ptr %p
  ret i64 %v
}

; A stack argument is read R15-relative too.
define i64 @leaf_stack_arg(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e) nounwind {
; CHECK-LABEL: leaf_stack_arg:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx64 r12, r15, 16
; CHECK-NEXT:    addr r12, r0, r12
; CHECK-NEXT:    leaveret
;
; FRAME-LABEL: leaf_stack_arg:
; FRAME:       # %bb.0:
; FRAME-NEXT:    enter 0
; FRAME-NEXT:    ldidx64 r12, r15, 16
; FRAME-NEXT:    addr r12, r0, r12
; FRAME-NEXT:    leaveret
  %r = add i64 %a, %e
  ret i64 %r
}

; A callee-saved register needs a spill slot.
define void @leaf_csr(ptr %p) nounwind {
; CHECK-LABEL: leaf_csr:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 1
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
;
; FRAME-LABEL: leaf_csr:
; FRAME:       # %bb.0:
; FRAME-NEXT:    enter 1
; FRAME-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; FRAME-NEXT:    #APP
; FRAME-NEXT:    #NO_APP
; FRAME-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; FRAME-NEXT:    leaveret
  call void asm sideeffect "", "~{r4}"()
  ret void
}

; __builtin_return_address / __builtin_frame_address read the frame record.
define ptr @leaf_retaddr() nounwind {
; CHECK-LABEL: leaf_retaddr:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx64 r12, r15, 8
; CHECK-NEXT:    leaveret
;
; FRAME-LABEL: leaf_retaddr:
; FRAME:       # %bb.0:
; FRAME-NEXT:    enter 0
; FRAME-NEXT:    ldidx64 r12, r15, 8
; FRAME-NEXT:    leaveret
  %r = call ptr @llvm.returnaddress(i32 0)
  ret ptr %r
}

define ptr @leaf_frameaddr() nounwind {
; CHECK-LABEL: leaf_frameaddr:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    copy r12, r15
; CHECK-NEXT:    leaveret
;
; FRAME-LABEL: leaf_frameaddr:
; FRAME:       # %bb.0:
; FRAME-NEXT:    enter 0
; FRAME-NEXT:    copy r12, r15
; FRAME-NEXT:    leaveret
  %r = call ptr @llvm.frameaddress(i32 0)
  ret ptr %r
}

; A variadic function stores its register arguments in the home area.
define i64 @leaf_vararg(i64 %a, ...) nounwind {
; CHECK-LABEL: leaf_vararg:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    copy r12, r0
; CHECK-NEXT:    stidx64 r3, r15, 40
; CHECK-NEXT:    stidx64 r2, r15, 32
; CHECK-NEXT:    stidx64 r1, r15, 24
; CHECK-NEXT:    leaveret
;
; FRAME-LABEL: leaf_vararg:
; FRAME:       # %bb.0:
; FRAME-NEXT:    enter 0
; FRAME-NEXT:    copy r12, r0
; FRAME-NEXT:    stidx64 r3, r15, 40
; FRAME-NEXT:    stidx64 r2, r15, 32
; FRAME-NEXT:    stidx64 r1, r15, 24
; FRAME-NEXT:    leaveret
  ret i64 %a
}

declare void @g()

; A call: a frame.
define void @nonleaf() nounwind {
; CHECK-LABEL: nonleaf:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    callrel g
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    leaveret
;
; FRAME-LABEL: nonleaf:
; FRAME:       # %bb.0:
; FRAME-NEXT:    enter 0
; FRAME-NEXT:    callrel g
; FRAME-NEXT:    #APP
; FRAME-NEXT:    #NO_APP
; FRAME-NEXT:    leaveret
  call void @g()
  call void asm sideeffect "", ""()
  ret void
}

declare ptr @llvm.returnaddress(i32)
declare ptr @llvm.frameaddress(i32)
