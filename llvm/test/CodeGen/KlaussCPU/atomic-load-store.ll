; Forced atomics: a naturally aligned atomic load or store of 1, 2, 4 or 8
; bytes is a plain load or store, whatever the ordering (the in-order core
; makes every access visible in program order, and no fence is inserted).
; Every addressing mode of the plain accesses applies: [r], r + simm32, a
; frame slot and r + r.  The result of a sub-word load is zero-extended
; (getExtendForAtomicOps); a sign extension of it folds into the
; sign-extending load.

@b = global i8 0
@h = global i16 0
@w = global i32 0
@d = global i64 0

define i8 @load_i8_monotonic() nounwind {
; CHECK-LABEL: load_i8_monotonic:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    setru r12, b
; CHECK-NEXT:    ldidx8 r12, r12, 0
; CHECK-NEXT:    leaveret
;
; O0-LABEL: load_i8_monotonic:
; O0:       # %bb.0:
; O0-NEXT:    enter 0
; O0-NEXT:    setru r12, b
; O0-NEXT:    ldidx8 r12, r12, 0
; O0-NEXT:    leaveret
  %v = load atomic i8, ptr @b monotonic, align 1
  ret i8 %v
}

