; CHECK-NEXT:    stidx64 r12, r0, 0
; CHECK-NEXT:    stidx64 r14, r1, 0
; CHECK-NEXT:    ldidx64 r12, r0, 8
; CHECK-NEXT:    leaveret
;
; O0-LABEL: order:
; O0:       # %bb.0:
; O0-NEXT:    enter 0
