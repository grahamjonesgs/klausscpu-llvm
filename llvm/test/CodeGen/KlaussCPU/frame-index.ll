}

; Fields of a local struct: every width and extension at a constant offset is
; one access off R15, with no separate frame address.
define i64 @field_offsets(i64 %a, i64 %b) nounwind {
; CHECK-LABEL: field_offsets:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 9
; CHECK-NEXT:    stidx64 r5, r15, -16 # 8-byte Folded Spill
; CHECK-NEXT:    copy r5, r0
; CHECK-NEXT:    addi r0, r15, -48
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r1
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    stidx8 r5, r15, -47
; CHECK-NEXT:    stidx16 r5, r15, -46
; CHECK-NEXT:    stidx32 r5, r15, -44
; CHECK-NEXT:    stidx64 r4, r15, -40
; CHECK-NEXT:    ldidx8 r12, r15, -47
; CHECK-NEXT:    ldidx8s r14, r15, -47
; CHECK-NEXT:    ldidx16 r13, r15, -46
; CHECK-NEXT:    addr r12, r12, r14
; CHECK-NEXT:    ldidx16s r14, r15, -46
; CHECK-NEXT:    addr r12, r12, r13
; CHECK-NEXT:    ldidx32 r13, r15, -44
; CHECK-NEXT:    addr r12, r12, r14
; CHECK-NEXT:    ldidx32s r14, r15, -44
; CHECK-NEXT:    addr r12, r12, r13
; CHECK-NEXT:    ldidx64 r13, r15, -40
; CHECK-NEXT:    addr r12, r12, r14
; CHECK-NEXT:    ldidx64 r5, r15, -16 # 8-byte Folded Reload
; CHECK-NEXT:    addr r12, r12, r13
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
  %s = alloca [4 x i64], align 8
  call void @use(ptr %s)
  %f8 = getelementptr inbounds i8, ptr %s, i64 1
  %f16 = getelementptr inbounds i8, ptr %s, i64 2
  %f32 = getelementptr inbounds i8, ptr %s, i64 4
  %f64 = getelementptr inbounds i8, ptr %s, i64 8
  %t8 = trunc i64 %a to i8
  %t16 = trunc i64 %a to i16
  %t32 = trunc i64 %a to i32
  store volatile i8 %t8, ptr %f8
  store volatile i16 %t16, ptr %f16
  store volatile i32 %t32, ptr %f32
  store volatile i64 %b, ptr %f64
  %x8 = load volatile i8, ptr %f8
  %x8s = load volatile i8, ptr %f8
  %x16 = load volatile i16, ptr %f16
  %x16s = load volatile i16, ptr %f16
  %x32 = load volatile i32, ptr %f32
  %x32s = load volatile i32, ptr %f32
  %x64 = load volatile i64, ptr %f64
  %e8 = zext i8 %x8 to i64
  %e8s = sext i8 %x8s to i64
  %e16 = zext i16 %x16 to i64
  %e16s = sext i16 %x16s to i64
  %e32 = zext i32 %x32 to i64
  %e32s = sext i32 %x32s to i64
  %s1 = add i64 %e8, %e8s
  %s2 = add i64 %s1, %e16
  %s3 = add i64 %s2, %e16s
  %s4 = add i64 %s3, %e32
  %s5 = add i64 %s4, %e32s
  %s6 = add i64 %s5, %x64
  ret i64 %s6
}

; A frame address plus a constant as a value is one ADDI.
define void @address_plus_offset() nounwind {
; CHECK-LABEL: address_plus_offset:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 6
; CHECK-NEXT:    addi r0, r15, -8
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    leaveret
  %st = alloca [3 x i64]
  %q = getelementptr inbounds i8, ptr %st, i64 16
  call void @use(ptr %q)
  ret void
}

; An aligned slot plus a constant below its alignment is an `or` in the DAG,
; folded like an add.
define i64 @or_offset(i32 %v) nounwind {
; CHECK-LABEL: or_offset:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 5
; CHECK-NEXT:    stidx32 r0, r15, -12
; CHECK-NEXT:    addi r0, r15, -16
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    ldidx32 r12, r15, -12
; CHECK-NEXT:    leaveret
  %st = alloca [2 x i64], align 8
  %p = ptrtoint ptr %st to i64
  %o = or disjoint i64 %p, 4
  %q = inttoptr i64 %o to ptr
  store i32 %v, ptr %q
  call void @use(ptr %st)
  %r = load i32, ptr %q
  %e = zext i32 %r to i64
  ret i64 %e
}

; 2^29 - 8 is folded; 2^29 is not (the frame address is computed first).
define i64 @offset_limit() nounwind {
; CHECK-LABEL: offset_limit:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 1
; CHECK-NEXT:    ldidx64 r12, r15, 536870896
; CHECK-NEXT:    leaveret
  %st = alloca i64
  %p = getelementptr i8, ptr %st, i64 536870904
  %r = load volatile i64, ptr %p
  ret i64 %r
}

define i64 @offset_over_limit() nounwind {
; CHECK-LABEL: offset_over_limit:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 1
; CHECK-NEXT:    addi r12, r15, -8
; CHECK-NEXT:    ldidx64 r12, r12, 536870912
; CHECK-NEXT:    leaveret
  %st = alloca i64
  %p = getelementptr i8, ptr %st, i64 536870912
  %r = load volatile i64, ptr %p
  ret i64 %r
}

; Out of short-form reach (behind a 2 KiB local), a slot with three or more
; accesses keeps its address in a register so each access is 1 word; with
; at most two, the constant is still folded.
define void @far_many(i64 %v) nounwind {
; CHECK-LABEL: far_many:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 264
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r0
; CHECK-NEXT:    addi r0, r15, -2056
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    addi r12, r15, -2088
; CHECK-NEXT:    stidx64 r4, r15, -2088
; CHECK-NEXT:    stidx64 r4, r12, 8
; CHECK-NEXT:    stidx64 r4, r12, 16
; CHECK-NEXT:    stidx64 r4, r12, 24
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
  %pad = alloca [256 x i64]
  %s = alloca [4 x i64]
  call void @use(ptr %pad)
  %p1 = getelementptr inbounds i8, ptr %s, i64 8
  %p2 = getelementptr inbounds i8, ptr %s, i64 16
  %p3 = getelementptr inbounds i8, ptr %s, i64 24
  store volatile i64 %v, ptr %s
  store volatile i64 %v, ptr %p1
  store volatile i64 %v, ptr %p2
  store volatile i64 %v, ptr %p3
  ret void
}

define void @far_few(i64 %v) nounwind {
; CHECK-LABEL: far_few:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 264
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    copy r4, r0
; CHECK-NEXT:    addi r0, r15, -2056
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    stidx64 r4, r15, -2080
; CHECK-NEXT:    stidx64 r4, r15, -2072
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
  %pad = alloca [256 x i64]
  %s = alloca [4 x i64]
  call void @use(ptr %pad)
  %p1 = getelementptr inbounds i8, ptr %s, i64 8
