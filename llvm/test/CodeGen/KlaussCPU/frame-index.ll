  ret void
}

; A realigned frame: the slot is addressed off the base pointer R7 with the
; constant folded in.
define i64 @realigned(i64 %v) nounwind {
; CHECK-LABEL: realigned:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 15
; CHECK-NEXT:    stidx64 r7, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    andi r7, r15, -32
; CHECK-NEXT:    stidx64 r0, r7, -40
; CHECK-NEXT:    addi r0, r7, -64
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    ldidx64 r12, r7, -40
; CHECK-NEXT:    ldidx64 r7, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
  %st = alloca [4 x i64], align 32
  %q = getelementptr inbounds i8, ptr %st, i64 24
  store i64 %v, ptr %q
  call void @use(ptr %st)
  %r = load i64, ptr %q
  ret i64 %r
}

; With a VLA the locals stay R15-relative, constant folded in.
define i64 @with_vla(i64 %n, i64 %v) nounwind {
; CHECK-LABEL: with_vla:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 2
; CHECK-NEXT:    addi r12, r0, 7
; CHECK-NEXT:    stidx64 r1, r15, -8
; CHECK-NEXT:    andi r12, r12, -8
; CHECK-NEXT:    getsp r14
; CHECK-NEXT:    subr r0, r14, r12
; CHECK-NEXT:    setsp r0
; CHECK-NEXT:    addsp -24
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    addsp 24
; CHECK-NEXT:    addsp -24
; CHECK-NEXT:    addi r0, r15, -16
; CHECK-NEXT:    callrel use
; CHECK-NEXT:    addsp 24
; CHECK-NEXT:    ldidx64 r12, r15, -8
; CHECK-NEXT:    leaveret
  %st = alloca [2 x i64]
