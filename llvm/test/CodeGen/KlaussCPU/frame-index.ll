; CHECK-NEXT:    stidx64 r4, r15, -56
; CHECK-NEXT:    stidx64 r4, r15, -48
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
  %pad = alloca [4 x i64]
