; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=klausscpu -O2 -verify-machineinstrs < %s | FileCheck %s
;
; Frame-index selection: a load or store straight off a frame index is the
; base+offset form with the frame register as its base (every width and
; extension), a frame address taken as a value is one ADDI (the AddrFI
; pattern), and a frame index plus a constant is not folded into the access.

declare void @use(ptr)

define i64 @loads_stores(i64 %a, i32 %b, i16 %c, i8 %d) nounwind {
; CHECK-LABEL: loads_stores:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 2
; CHECK-NEXT:    stidx64 r0, r15, -8
; CHECK-NEXT:    stidx32 r1, r15, -12
; CHECK-NEXT:    stidx16 r2, r15, -14
; CHECK-NEXT:    stidx8 r3, r15, -15
; CHECK-NEXT:    ldidx64 r12, r15, -8
; CHECK-NEXT:    ldidx32 r14, r15, -12
; CHECK-NEXT:    ldidx32s r13, r15, -12
; CHECK-NEXT:    addr r12, r12, r14
; CHECK-NEXT:    ldidx16 r14, r15, -14
; CHECK-NEXT:    addr r12, r12, r13
; CHECK-NEXT:    ldidx16s r13, r15, -14
; CHECK-NEXT:    addr r12, r12, r14
; CHECK-NEXT:    ldidx8 r14, r15, -15
; CHECK-NEXT:    addr r12, r12, r13
; CHECK-NEXT:    ldidx8s r13, r15, -15
; CHECK-NEXT:    addr r12, r12, r14
; CHECK-NEXT:    addr r12, r12, r13
; CHECK-NEXT:    leaveret
  %p64 = alloca i64
  %p32 = alloca i32
  %p16 = alloca i16
  %p8 = alloca i8
  store volatile i64 %a, ptr %p64
  store volatile i32 %b, ptr %p32
  store volatile i16 %c, ptr %p16
  store volatile i8 %d, ptr %p8
  %x = load volatile i64, ptr %p64
  %y = load volatile i32, ptr %p32
  %ys = load volatile i32, ptr %p32
  %z = load volatile i16, ptr %p16
  %zs = load volatile i16, ptr %p16
  %w = load volatile i8, ptr %p8
  %ws = load volatile i8, ptr %p8
  %y64 = zext i32 %y to i64
  %ys64 = sext i32 %ys to i64
  %z64 = zext i16 %z to i64
  %zs64 = sext i16 %zs to i64
  %w64 = zext i8 %w to i64
  %ws64 = sext i8 %ws to i64
  %s1 = add i64 %x, %y64
  %s2 = add i64 %s1, %ys64
  %s3 = add i64 %s2, %z64
  %s4 = add i64 %s3, %zs64
  %s5 = add i64 %s4, %w64
  %s6 = add i64 %s5, %ws64
  ret i64 %s6
}

define i64 @address_taken() nounwind {
; CHECK-LABEL: address_taken:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 7
; CHECK-NEXT:    stidx64 r4, r15, -8 # 8-byte Folded Spill
; CHECK-NEXT:    addi r4, r15, -32
; CHECK-NEXT:    copy r0, r4
; CHECK-NEXT:    call use
; CHECK-NEXT:    ldidx64 r12, r4, 8
; CHECK-NEXT:    ldidx64 r4, r15, -8 # 8-byte Folded Reload
; CHECK-NEXT:    leaveret
  %st = alloca [3 x i64]
  call void @use(ptr %st)
  %q = getelementptr inbounds i8, ptr %st, i64 8
  %v = load i64, ptr %q
  ret i64 %v
}
