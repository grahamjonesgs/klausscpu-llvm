; A polling loop reads the register in the loop: no address register.
define void @poll(i32 %c) nounwind {
; CHECK-LABEL: poll:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB6_1: # %wait
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldabs32 r12, 4026597392
; CHECK-NEXT:    andv r12, r12, 1
; CHECK-NEXT:    fbri r12, 0, 8, .LBB6_1
; CHECK-NEXT:  # %bb.2: # %done
; CHECK-NEXT:    stabs32 r0, 4026597376
; CHECK-NEXT:    leaveret
;
; O0-LABEL: poll:
; O0:       # %bb.0: # %entry
; O0-NEXT:    enter 1
; O0-NEXT:    stidx64 r0, r15, -8 # 8-byte Folded Spill
; O0-NEXT:    jmprel .LBB6_1
; O0-NEXT:  .LBB6_1: # %wait
; O0-NEXT:    # =>This Inner Loop Header: Depth=1
; O0-NEXT:    ldabs32 r12, 4026597392
; O0-NEXT:    andv r12, r12, 1
; O0-NEXT:    fbri r12, 0, 8, .LBB6_1
; O0-NEXT:    jmprel .LBB6_2
; O0-NEXT:  .LBB6_2: # %done
; O0-NEXT:    ldidx64 r12, r15, -8 # 8-byte Folded Reload
; O0-NEXT:    stabs32 r12, 4026597376
; O0-NEXT:    leaveret
entry:
  br label %wait
wait:
  %s = load volatile i32, ptr inttoptr (i64 4026597392 to ptr)
  %busy = and i32 %s, 1
  %b = icmp ne i32 %busy, 0
  br i1 %b, label %wait, label %done
done:
  store volatile i32 %c, ptr inttoptr (i64 4026597376 to ptr)
  ret void
}

