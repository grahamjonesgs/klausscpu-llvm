; A load or store at a constant address (an MMIO register) is one 2-word
; absolute access (MODE=10, EA = imm32) at every width, with the extension
; of the load: ldabs8/16/32[s], stabs8/16/32, memreadr/memsetr.  Without it,
; it was setru + memgetN / memsetN (2 instructions, 3 words).  Only a
; naturally aligned constant: the 16/32-bit absolute forms align the EA down
; where memget32 does not.  The CPU uses bits [31:0] of an address, so a
; constant that setr sign-extends is the same address as its low half.

define i64 @ld8() nounwind {
; CHECK-LABEL: ld8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldabs8 r12, 4026597377
; CHECK-NEXT:    ldabs8s r14, 4026597378
; CHECK-NEXT:    addr r12, r12, r14
; CHECK-NEXT:    leaveret
;
; O0-LABEL: ld8:
; O0:       # %bb.0:
; O0-NEXT:    enter 0
; O0-NEXT:    ldabs8 r12, 4026597377
; O0-NEXT:    ldabs8s r14, 4026597378
; O0-NEXT:    addr r12, r12, r14
; O0-NEXT:    leaveret
  %a = load volatile i8, ptr inttoptr (i64 4026597377 to ptr)
  %b = load volatile i8, ptr inttoptr (i64 4026597378 to ptr)
  %za = zext i8 %a to i64
  %sb = sext i8 %b to i64
  %r = add i64 %za, %sb
  ret i64 %r
}

