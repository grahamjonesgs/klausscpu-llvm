# RUN: llc -march=klausscpu -run-pass=post-RA-sched -o - %s | FileCheck %s
#
# The post-RA scheduler leaves memory ops next to each other.  On klaussCPU
# fetch-2a a memory op behind another waits for the data port, and an
# independent ALU op put between them costs its own cycle (board perf_kern:
# `ld ; alu ; ld` 6.93 cycles, `ld ; ld` 5.93), so the port model that moved
# ALU work into that gap (8e6b8e5) is gone and the memory ops, ready first,
# issue back to back.  (A load in a store's 32-byte line is kept apart:
# sched-store-load-line.mir.)
---
name:            two_stores
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r12, $r14

    ; CHECK-LABEL: name: two_stores
    ; CHECK:      STIDX64 killed $r1, $r0, 0
    ; CHECK-NEXT: STIDX64 killed $r2, killed $r0, 8
    STIDX64 $r1, $r0, 0 :: (store (s64))
    STIDX64 $r2, $r0, 8 :: (store (s64))
    $r12 = INCR killed $r12, implicit-def dead $flags
    $r14 = INCR killed $r14, implicit-def dead $flags
    RET_I
...
---
name:            store_load
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1, $r12, $r13, $r14

    ; CHECK-LABEL: name: store_load
    ; CHECK:      STIDX64 killed $r1, $r0, 0
    ; CHECK-NEXT: $r13 = LDIDX64 killed $r0, 32
    STIDX64 $r1, $r0, 0 :: (store (s64))
    $r13 = LDIDX64 $r0, 32 :: (load (s64))
    $r12 = INCR killed $r12, implicit-def dead $flags
    $r14 = INCR killed $r14, implicit-def dead $flags
    RET_I
...
---
name:            two_loads
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r12, $r14

    ; CHECK-LABEL: name: two_loads
    ; CHECK:      $r1 = LDIDX64 $r0, 0
    ; CHECK-NEXT: $r2 = LDIDX64 killed $r0, 8
    $r1 = LDIDX64 $r0, 0 :: (load (s64))
    $r2 = LDIDX64 $r0, 8 :: (load (s64))
    $r12 = INCR killed $r12, implicit-def dead $flags
    $r14 = INCR killed $r14, implicit-def dead $flags
    RET_I
...
