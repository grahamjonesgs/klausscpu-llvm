; The MachineOutliner (KlaussCPUInstrInfo.cpp, "Outlining") runs by default
; on minsize (-Oz) functions.  CALL pushes the return address, so an
; outlined function is called with a plain call and returns with RET
; (Default), is jumped to when the sequence ends in a return (TailCall:
; RET, or an epilogue's LEAVERET), or ends in a tail jump to the callee of
; the call that ends the sequence (Thunk).  Nothing that uses SP is
; outlined into a called function.
; An epilogue (callee-saved restores, LEAVERET) runs in the frame of the
; function it came from: its CFI says so (CFA = R15 + 16, the restored
; registers' slots).  A call with a stack argument keeps its GETSP; the
; stores through it can go into a Thunk, whose callee is entered with SP
; and [SP] as the original call would have left them.

declare i64 @g(i64, i64)
declare i64 @g5(i64, i64, i64, i64, i64)
declare i64 @h(i64)

; Frameless leaves with the same body and return: TailCall.
define i64 @leaf1(ptr %p, i64 %x) minsize nounwind {
  %a = add i64 %x, 3
  %b = mul i64 %x, 7
  %c = xor i64 %a, %b
  store i64 %a, ptr %p
  %q = getelementptr i64, ptr %p, i64 1
  store i64 %b, ptr %q
  ret i64 %c
}
define i64 @leaf2(ptr %p, i64 %x) minsize nounwind {
  %a = add i64 %x, 3
  %b = mul i64 %x, 7
  %c = xor i64 %a, %b
  store i64 %a, ptr %p
  %q = getelementptr i64, ptr %p, i64 1
  store i64 %b, ptr %q
  ret i64 %c
}
define i64 @leaf3(ptr %p, i64 %x) minsize nounwind {
  %a = add i64 %x, 3
  %b = mul i64 %x, 7
  %c = xor i64 %a, %b
  store i64 %a, ptr %p
  %q = getelementptr i64, ptr %p, i64 1
  store i64 %b, ptr %q
  ret i64 %c
}

; The same argument set-up in front of a call: Thunk.
define i64 @thunk1(ptr %p) minsize nounwind {
  %v = load i64, ptr %p
