; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -march=klausscpu -verify-machineinstrs -O2 < %s | FileCheck %s
; RUN: llc -march=klausscpu -verify-machineinstrs -O2 \
; RUN:   -klausscpu-sched-cmp-br-pair=false < %s | FileCheck %s --check-prefix=NOPAIR

; The pre-RA scheduler keeps a compare next to the branch that reads its
; flags.  Without that it sinks the independent value below the compare,
; register allocation gives it the compare operand's register (free once the
; compare has read it), and the redefinition between compare and branch
; stops KlaussCPUFuseCmpBr: CMPRV + JMPEREL instead of one FBRI.

define i64 @value_below_compare(i32 %a, i32 %b, i1 %p) nounwind {
; CHECK-LABEL: value_below_compare:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    andv r14, r2, 1
; CHECK-NEXT:    cmpltrw r12, r0, r1
; CHECK-NEXT:    fbri r14, 0, 0, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    addr r12, r12, r12
; CHECK-NEXT:  .LBB0_2: # %f
; CHECK-NEXT:    ret
;
; NOPAIR-LABEL: value_below_compare:
; NOPAIR:       # %bb.0: # %entry
; NOPAIR-NEXT:    andv r12, r2, 1
; NOPAIR-NEXT:    cmprv r12, 0
; NOPAIR-NEXT:    cmpltrw r12, r0, r1
; NOPAIR-NEXT:    jmperel .LBB0_2
; NOPAIR-NEXT:  # %bb.1: # %t
; NOPAIR-NEXT:    addr r12, r12, r12
; NOPAIR-NEXT:  .LBB0_2: # %f
; NOPAIR-NEXT:    ret
entry:
  %c = icmp slt i32 %a, %b
  %z = zext i1 %c to i64
  br i1 %p, label %t, label %f
t:
  %q = add i64 %z, %z
  ret i64 %q
f:
  ret i64 %z
}
