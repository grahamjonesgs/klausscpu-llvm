; RUN: llc -march=klausscpu -O2 -verify-machineinstrs -stop-after=finalize-isel < %s \
; RUN:   | FileCheck %s

; Two selects on one condition share a compare and branch.  The DBG_VALUE of
; the first select's result, which sits between the selects, moves behind the
; PHIs (where that result is defined), in its original order.

define i64 @dbg(i64 %a, i64 %b, i64 %c, i64 %d) nounwind !dbg !5 {
  ; CHECK-LABEL: name: dbg
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $r0, $r1, $r2, $r3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r3
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $r2
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr = COPY $r1
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr = COPY $r0
  ; CHECK-NEXT:   CMPRR_I [[COPY3]], [[COPY2]], implicit-def $flags, debug-location !7
  ; CHECK-NEXT:   JMPLT %bb.2, implicit $flags, debug-location !7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (%ir-block.0):
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[COPY1]], %bb.0, [[COPY]], %bb.1, debug-location !7
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gpr = PHI [[COPY]], %bb.0, [[COPY1]], %bb.1, debug-location !7
  ; CHECK-NEXT:   DBG_VALUE [[PHI]], $noreg, !8, !DIExpression(), debug-location !7
  ; CHECK-NEXT:   DBG_VALUE [[PHI1]], $noreg, !10, !DIExpression(), debug-location !7
  ; CHECK-NEXT:   [[SUBR:%[0-9]+]]:gpr = SUBR killed [[PHI]], killed [[PHI1]], implicit-def dead $flags, debug-location !7
  ; CHECK-NEXT:   $r12 = COPY [[SUBR]], debug-location !7
  ; CHECK-NEXT:   RET_I implicit $r12, debug-location !7
  %cmp = icmp slt i64 %a, %b
  %x = select i1 %cmp, i64 %c, i64 %d, !dbg !10
    #dbg_value(i64 %x, !9, !DIExpression(), !10)
  %y = select i1 %cmp, i64 %d, i64 %c, !dbg !10
    #dbg_value(i64 %y, !11, !DIExpression(), !10)
  %s = sub i64 %x, %y, !dbg !10
  ret i64 %s, !dbg !10
}

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!3, !4}
!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "t", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
!1 = !DIFile(filename: "t.c", directory: "/")
!3 = !{i32 2, !"Debug Info Version", i32 3}
!4 = !{i32 7, !"Dwarf Version", i32 5}
!5 = distinct !DISubprogram(name: "dbg", scope: !1, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
!6 = !DISubroutineType(types: !7)
!7 = !{null}
!8 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
!9 = !DILocalVariable(name: "x", scope: !5, file: !1, line: 1, type: !8)
!10 = !DILocation(line: 1, scope: !5)
!11 = !DILocalVariable(name: "y", scope: !5, file: !1, line: 1, type: !8)
