; PIE-NEXT:    ret
;
; SHARED-LABEL: get_loc:
; SHARED:       # %bb.0:
; SHARED-NEXT:    enter 0
; SHARED-NEXT:    leapc r0, %tlsgd(.Lloc$local)
; SHARED-NEXT:    callrel __tls_get_addr
; SHARED-NEXT:    memget32 r12, r12
; SHARED-NEXT:    leaveret
;
; SHARED-O0-LABEL: get_loc:
; SHARED-O0:       # %bb.0:
; SHARED-O0-NEXT:    enter 0
; SHARED-O0-NEXT:    leapc r0, %tlsgd(.Lloc$local)
; SHARED-O0-NEXT:    callrel __tls_get_addr
; SHARED-O0-NEXT:    memget32 r12, r12
; SHARED-O0-NEXT:    leaveret
;
; STATIC-LABEL: get_loc:
; STATIC:       # %bb.0:
; STATIC-NEXT:    mfsr r12, tp
; STATIC-NEXT:    ldidx32 r12, r12, %tprel(loc)
; STATIC-NEXT:    ret
  %p = call ptr @llvm.threadlocal.address.p0(ptr @loc)
  %v = load i32, ptr %p
  ret i32 %v
}

