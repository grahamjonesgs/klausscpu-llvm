; SHARED-O0-NEXT:    leapc r0, %tlsgd(arr)
; SHARED-O0-NEXT:    callrel __tls_get_addr
; SHARED-O0-NEXT:    ldidx64 r0, r15, -16 # 8-byte Folded Reload
