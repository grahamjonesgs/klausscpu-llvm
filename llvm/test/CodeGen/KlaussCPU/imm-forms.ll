; Source stays live: untied INCR/SHLV write a different register, no COPY.
define i64 @untied(i64 %a) {
; CHECK-LABEL: untied:
; CHECK:       # %bb.0:
; CHECK-NEXT:    push r15
; CHECK-NEXT:    getsp r15
; CHECK-NEXT:    incr r12, r0
; CHECK-NEXT:    mulr r12, r0, r12
; CHECK-NEXT:    shlv r12, r12, 4
; CHECK-NEXT:    setsp r15
; CHECK-NEXT:    pop r15
; CHECK-NEXT:    ret
  %b = add i64 %a, 1
  %c = shl i64 %a, 4
  %r = mul i64 %b, %c
  ret i64 %r
}

; setcc produces exactly 0/1 (ZeroOrOneBooleanContent): no masking ANDV.
define i64 @bool_zext(i64 %a, i64 %b) {
; CHECK-LABEL: bool_zext:
; CHECK:       # %bb.0:
; CHECK-NEXT:    push r15
; CHECK-NEXT:    getsp r15
; CHECK-NEXT:    cmpultr r12, r0, r1
; CHECK-NEXT:    setsp r15
; CHECK-NEXT:    pop r15
; CHECK-NEXT:    ret
  %c = icmp ult i64 %a, %b
  %r = zext i1 %c to i64
  ret i64 %r
}
