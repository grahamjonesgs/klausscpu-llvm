# KlaussCPUFuseCmpBr does not fuse a branch whose next instruction in layout
# (the one a taken FBR squashes in EX) is a divide. The RTL divider latches
# that wrong-path divide's operands and keeps running after the squash, and
# the next real divide then completes with its result. The next instruction
# is the one after the branch in its block, else the first instruction
# emitted in the following blocks: instructions that emit nothing are
# skipped, an empty block is passed over, and a non-empty inline asm counts
# as a divide. A divide at the branch target, or later in the fall-through
# block, is not in the shadow.
#
# RUN: llc -march=klausscpu -run-pass=klausscpu-cmp-br-fuse -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s

--- |
  define void @divides() { ret void }
  define void @meta_and_empty_block() { ret void }
  define void @inline_asm() { ret void }
  define void @not_in_shadow() { ret void }
...
---
# Every divide form: DIVR, DIVUR, MODR, MODUR, DIVV, MODV.
# CHECK-LABEL: name: divides
# CHECK-NOT:   FBR_
# CHECK:       CMPRV_I $r1, 0, implicit-def $flags
# CHECK-NEXT:  JMPE %bb.7
# CHECK:       $r12 = DIVR
# CHECK:       CMPRV_I $r1, 1, implicit-def $flags
# CHECK-NEXT:  JMPE %bb.7
# CHECK:       $r12 = DIVUR
# CHECK:       CMPRV_I $r1, 2, implicit-def $flags
# CHECK-NEXT:  JMPE %bb.7
# CHECK:       $r12 = MODR
# CHECK:       CMPRV_I $r1, 3, implicit-def $flags
# CHECK-NEXT:  JMPE %bb.7
# CHECK:       $r12 = MODUR
# CHECK:       CMPRR_I $r1, $r2, implicit-def $flags
# CHECK-NEXT:  JMPLT %bb.7
# CHECK:       $r12 = DIVV
# CHECK:       CMPRR_I $r1, $r2, implicit-def $flags
# CHECK-NEXT:  JMPULT %bb.7
# CHECK:       $r12 = MODV
# CHECK-NOT:   FBR_
name:            divides
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.7
    liveins: $r0, $r1, $r2
    CMPRV_I $r1, 0, implicit-def $flags
    JMPE %bb.7, implicit killed $flags

  bb.1:
    successors: %bb.2, %bb.7
    liveins: $r0, $r1, $r2
    $r12 = DIVR $r0, $r1, implicit-def dead $flags
    CMPRV_I $r1, 1, implicit-def $flags
    JMPE %bb.7, implicit killed $flags

  bb.2:
    successors: %bb.3, %bb.7
    liveins: $r0, $r1, $r2
    $r12 = DIVUR $r0, $r1, implicit-def dead $flags
    CMPRV_I $r1, 2, implicit-def $flags
    JMPE %bb.7, implicit killed $flags

  bb.3:
    successors: %bb.4, %bb.7
    liveins: $r0, $r1, $r2
    $r12 = MODR $r0, $r1, implicit-def dead $flags
    CMPRV_I $r1, 3, implicit-def $flags
    JMPE %bb.7, implicit killed $flags

  bb.4:
    successors: %bb.5, %bb.7
    liveins: $r0, $r1, $r2
    $r12 = MODUR $r0, $r1, implicit-def dead $flags
    CMPRR_I $r1, $r2, implicit-def $flags
    JMPLT %bb.7, implicit killed $flags

  bb.5:
    successors: %bb.6, %bb.7
    liveins: $r0, $r1, $r2
    $r12 = DIVV $r0, 7, implicit-def dead $flags
    CMPRR_I $r1, $r2, implicit-def $flags
    JMPULT %bb.7, implicit killed $flags

  bb.6:
    liveins: $r0
    $r12 = MODV $r0, 7, implicit-def dead $flags
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12

  bb.7:
    $r12 = SETR 0
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12
...
---
# Instructions that emit nothing before the divide, and an empty block
# between the branch and the divide.
# CHECK-LABEL: name: meta_and_empty_block
# CHECK-NOT:   FBR_
# CHECK:       CMPRV_I $r1, 0, implicit-def $flags
# CHECK-NEXT:  JMPE %bb.4
# CHECK:       $r12 = DIVR
# CHECK:       CMPRV_I $r1, 1, implicit-def $flags
# CHECK-NEXT:  JMPE %bb.4
# CHECK:       bb.2:
# CHECK:       bb.3:
# CHECK:       $r12 = DIVUR
# CHECK-NOT:   FBR_
name:            meta_and_empty_block
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.4
    liveins: $r0, $r1
    CMPRV_I $r1, 0, implicit-def $flags
    JMPE %bb.4, implicit killed $flags

  bb.1:
    successors: %bb.2, %bb.4
    liveins: $r0, $r1
    $r13 = IMPLICIT_DEF
    KILL $r13
    CFI_INSTRUCTION def_cfa_offset 16
    $r12 = DIVR $r0, $r1, implicit-def dead $flags
    CMPRV_I $r1, 1, implicit-def $flags
    JMPE %bb.4, implicit killed $flags

  bb.2:
    successors: %bb.3
    liveins: $r0, $r1

  bb.3:
    liveins: $r0, $r1
    $r12 = DIVUR $r0, $r1, implicit-def dead $flags
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12

  bb.4:
    $r12 = SETR 0
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12
...
---
# A non-empty inline asm may start with a divide; an empty one emits nothing
# and the instruction after it decides.
# CHECK-LABEL: name: inline_asm
# CHECK:       CMPRV_I $r1, 0, implicit-def $flags
# CHECK-NEXT:  JMPE %bb.4
# CHECK:       INLINEASM &"divr r12, r0, r1"
# CHECK:       FBR_RI $r1, 1, 0, %bb.4
# CHECK:       INLINEASM &" "
# CHECK-NEXT:  $r12 = SETR 1
# CHECK:       CMPRV_I $r1, 2, implicit-def $flags
# CHECK-NEXT:  JMPE %bb.4
# CHECK:       INLINEASM &""
# CHECK-NEXT:  $r12 = MODR
name:            inline_asm
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.4
    liveins: $r0, $r1
    CMPRV_I $r1, 0, implicit-def $flags
    JMPE %bb.4, implicit killed $flags

  bb.1:
    successors: %bb.2, %bb.4
    liveins: $r0, $r1
    INLINEASM &"divr r12, r0, r1", 1 /* sideeffect attdialect */
    CMPRV_I $r1, 1, implicit-def $flags
    JMPE %bb.4, implicit killed $flags

  bb.2:
    successors: %bb.3, %bb.4
    liveins: $r0, $r1
    INLINEASM &" ", 1 /* sideeffect attdialect */
    $r12 = SETR 1
    CMPRV_I $r1, 2, implicit-def $flags
    JMPE %bb.4, implicit killed $flags

  bb.3:
    liveins: $r0, $r1
    INLINEASM &"", 1 /* sideeffect attdialect */
    $r12 = MODR $r0, $r1, implicit-def dead $flags
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12

  bb.4:
    $r12 = SETR 0
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12
...
---
# Fused: a divide at the branch target, a divide behind another instruction
# in the fall-through block, and a divide behind a JMP that follows the
# branch in its block.
# CHECK-LABEL: name: not_in_shadow
# CHECK:       FBR_RI $r1, 0, 0, %bb.3
# CHECK:       bb.1:
# CHECK:       $r13 = SETR 1
# CHECK-NEXT:  $r12 = DIVR
# CHECK-NEXT:  FBR_RI $r1, 1, 0, %bb.3
# CHECK-NEXT:  JMP %bb.2
# CHECK-NOT:   CMPRV_I
name:            not_in_shadow
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $r0, $r1
    CMPRV_I $r1, 0, implicit-def $flags
    JMPE %bb.3, implicit killed $flags

  bb.1:
    successors: %bb.3, %bb.2
    liveins: $r0, $r1
    $r13 = SETR 1
    $r12 = DIVR $r0, $r1, implicit-def dead $flags
    CMPRV_I $r1, 1, implicit-def $flags
    JMPE %bb.3, implicit killed $flags
    JMP %bb.2

  bb.2:
    liveins: $r0, $r1
    $r12 = DIVR $r0, $r1, implicit-def dead $flags
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12

  bb.3:
    liveins: $r0, $r1
    $r12 = MODUR $r0, $r1, implicit-def dead $flags
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12
...
