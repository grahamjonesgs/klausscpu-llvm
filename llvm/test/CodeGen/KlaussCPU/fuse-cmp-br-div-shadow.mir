# KlaussCPUFuseCmpBr fuses a branch whatever its next instruction in layout
# (the one a taken FBR squashes in EX): since klaussCPU 9ad6614, the oldest
# core the backend supports, the squash resets the divider and gates the LCD
# strobe, so a divide or an LCD write there has no effect.  Before, the
# divider kept running on the wrong-path divide and handed its result to the
# next real one, and the LCD strobe fired, so such a branch stayed CMP +
# JMPcc.  Each case below is one that rule used to refuse: every divide
# form and LCD write, behind meta instructions or an empty block, and a
# non-empty inline asm, which only the range rule still considers.
#
# RUN: llc -march=klausscpu -run-pass=klausscpu-cmp-br-fuse -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s

--- |
  define void @divides() { ret void }
  define void @meta_and_empty_block() { ret void }
  define void @inline_asm() { ret void }
  define void @lcd_writes() { ret void }
  define void @inline_asm_after_loop() { ret void }
...
---
# Every divide form: DIVR, DIVUR, MODR, MODUR, DIVV, MODV.
# CHECK-LABEL: name: divides
# CHECK-NOT:   CMPR
# CHECK:       FBR_RI $r1, 0, 0, %bb.7
# CHECK:       $r12 = DIVR
# CHECK-NEXT:  FBR_RI $r1, 1, 0, %bb.7
# CHECK:       $r12 = DIVUR
# CHECK-NEXT:  FBR_RI $r1, 2, 0, %bb.7
# CHECK:       $r12 = MODR
# CHECK-NEXT:  FBR_RI $r1, 3, 0, %bb.7
# CHECK:       $r12 = MODUR
# CHECK-NEXT:  FBR_RR $r1, $r2, 1, %bb.7
# CHECK:       $r12 = DIVV
# CHECK-NEXT:  FBR_RR $r1, $r2, 3, %bb.7
# CHECK:       $r12 = MODV
# CHECK-NOT:   CMPR
name:            divides
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.7
    liveins: $r0, $r1, $r2
    CMPRV_I $r1, 0, implicit-def $flags
    JMPE %bb.7, implicit killed $flags

  bb.1:
    successors: %bb.2, %bb.7
    liveins: $r0, $r1, $r2
    $r12 = DIVR $r0, $r1, implicit-def dead $flags
    CMPRV_I $r1, 1, implicit-def $flags
    JMPE %bb.7, implicit killed $flags

  bb.2:
    successors: %bb.3, %bb.7
    liveins: $r0, $r1, $r2
    $r12 = DIVUR $r0, $r1, implicit-def dead $flags
    CMPRV_I $r1, 2, implicit-def $flags
    JMPE %bb.7, implicit killed $flags

  bb.3:
    successors: %bb.4, %bb.7
    liveins: $r0, $r1, $r2
    $r12 = MODR $r0, $r1, implicit-def dead $flags
    CMPRV_I $r1, 3, implicit-def $flags
    JMPE %bb.7, implicit killed $flags

  bb.4:
    successors: %bb.5, %bb.7
    liveins: $r0, $r1, $r2
    $r12 = MODUR $r0, $r1, implicit-def dead $flags
    CMPRR_I $r1, $r2, implicit-def $flags
    JMPLT %bb.7, implicit killed $flags

  bb.5:
    successors: %bb.6, %bb.7
    liveins: $r0, $r1, $r2
    $r12 = DIVV $r0, 7, implicit-def dead $flags
    CMPRR_I $r1, $r2, implicit-def $flags
    JMPULT %bb.7, implicit killed $flags

  bb.6:
    liveins: $r0
    $r12 = MODV $r0, 7, implicit-def dead $flags
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12

  bb.7:
    $r12 = SETR 0
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12
...
---
# Instructions that emit nothing before the divide, and an empty block
# between the branch and the divide.
# CHECK-LABEL: name: meta_and_empty_block
# CHECK-NOT:   CMPR
# CHECK:       FBR_RI $r1, 0, 0, %bb.4
# CHECK:       $r12 = DIVR
# CHECK-NEXT:  FBR_RI $r1, 1, 0, %bb.4
# CHECK:       bb.2:
# CHECK:       bb.3:
# CHECK:       $r12 = DIVUR
# CHECK-NOT:   CMPR
name:            meta_and_empty_block
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.4
    liveins: $r0, $r1
    CMPRV_I $r1, 0, implicit-def $flags
    JMPE %bb.4, implicit killed $flags

  bb.1:
    successors: %bb.2, %bb.4
    liveins: $r0, $r1
    $r13 = IMPLICIT_DEF
    KILL $r13
    CFI_INSTRUCTION def_cfa_offset 16
    $r12 = DIVR $r0, $r1, implicit-def dead $flags
    CMPRV_I $r1, 1, implicit-def $flags
    JMPE %bb.4, implicit killed $flags

  bb.2:
    successors: %bb.3
    liveins: $r0, $r1

  bb.3:
    liveins: $r0, $r1
    $r12 = DIVUR $r0, $r1, implicit-def dead $flags
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12

  bb.4:
    $r12 = SETR 0
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12
...
---
# A non-empty inline asm (a divide here) after the branch.  Only the first
# branch stays unfused: it spans that inline asm, whose size is unbounded
# (the range rule).  The other two span only inline asm that emits nothing.
# CHECK-LABEL: name: inline_asm
# CHECK:       CMPRV_I $r1, 0, implicit-def $flags
# CHECK-NEXT:  JMPE %bb.4
# CHECK:       INLINEASM &"divr r12, r0, r1"
# CHECK-NEXT:  FBR_RI $r1, 1, 0, %bb.4
# CHECK:       INLINEASM &" "
# CHECK-NEXT:  $r12 = SETR 1
# CHECK-NEXT:  FBR_RI $r1, 2, 0, %bb.4
# CHECK:       INLINEASM &""
# CHECK-NEXT:  $r12 = MODR
name:            inline_asm
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.4
    liveins: $r0, $r1
    CMPRV_I $r1, 0, implicit-def $flags
    JMPE %bb.4, implicit killed $flags

  bb.1:
    successors: %bb.2, %bb.4
    liveins: $r0, $r1
    INLINEASM &"divr r12, r0, r1", 1 /* sideeffect attdialect */
    CMPRV_I $r1, 1, implicit-def $flags
    JMPE %bb.4, implicit killed $flags

  bb.2:
    successors: %bb.3, %bb.4
    liveins: $r0, $r1
    INLINEASM &" ", 1 /* sideeffect attdialect */
    $r12 = SETR 1
    CMPRV_I $r1, 2, implicit-def $flags
    JMPE %bb.4, implicit killed $flags

  bb.3:
    liveins: $r0, $r1
    INLINEASM &"", 1 /* sideeffect attdialect */
    $r12 = MODR $r0, $r1, implicit-def dead $flags
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12

  bb.4:
    $r12 = SETR 0
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12
...
---
# The LCD writes LCDCMDV, LCDDATAV and LCDDATAR, and the LCD reset.
# CHECK-LABEL: name: lcd_writes
# CHECK-NOT:   CMPR
# CHECK:       FBR_RI $r1, 0, 0, %bb.5
# CHECK:       LCDCMDV 1
# CHECK-NEXT:  FBR_RI $r1, 1, 0, %bb.5
# CHECK:       LCDDATAV 2
# CHECK-NEXT:  FBR_RI $r1, 2, 0, %bb.5
# CHECK:       LCDDATAR $r0
# CHECK-NEXT:  FBR_RI $r1, 3, 0, %bb.5
# CHECK:       LCD 1
# CHECK-NOT:   CMPR
name:            lcd_writes
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.5
    liveins: $r0, $r1
    CMPRV_I $r1, 0, implicit-def $flags
    JMPE %bb.5, implicit killed $flags

  bb.1:
    successors: %bb.2, %bb.5
    liveins: $r0, $r1
    LCDCMDV 1
    CMPRV_I $r1, 1, implicit-def $flags
    JMPE %bb.5, implicit killed $flags

  bb.2:
    successors: %bb.3, %bb.5
    liveins: $r0, $r1
    LCDDATAV 2
    CMPRV_I $r1, 2, implicit-def $flags
    JMPE %bb.5, implicit killed $flags

  bb.3:
    successors: %bb.4, %bb.5
    liveins: $r0, $r1
    LCDDATAR $r0
    CMPRV_I $r1, 3, implicit-def $flags
    JMPE %bb.5, implicit killed $flags

  bb.4:
    LCD 1
    $r12 = SETR 1
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12

  bb.5:
    $r12 = SETR 0
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15, implicit killed $r12
...
---
# A backward branch whose fall-through starts with a non-empty inline asm
# (an LCD write here): the range rule does not stop it either.
# CHECK-LABEL: name: inline_asm_after_loop
# CHECK:       FBR_RI $r1, 0, 8, %bb.1
# CHECK:       bb.2:
# CHECK-NEXT:  INLINEASM &"lcddatav 65"
name:            inline_asm_after_loop
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $r1
    $r1 = DECR killed $r1, implicit-def dead $flags
    CMPRV_I $r1, 0, implicit-def $flags
    JMPNE %bb.1, implicit killed $flags

  bb.2:
    INLINEASM &"lcddatav 65", 1 /* sideeffect attdialect */
    LEAVERET_I implicit-def $sp, implicit-def $r15, implicit $r15
...
