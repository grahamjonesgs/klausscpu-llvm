# RUN: llc -march=klausscpu -run-pass=post-RA-sched -o - %s | FileCheck %s
# RUN: llc -march=klausscpu -run-pass=post-RA-sched \
# RUN:   -klausscpu-postra-store-load-line=false -o - %s \
# RUN:   | FileCheck %s --check-prefix=OFF
#
# klaussCPU 1a stage 3: a load whose 32-byte D-cache line a store issued 1 or
# 2 cycles earlier may still be writing takes the slow path, so the post-RA
# scheduler keeps two instructions between them when it has independent
# work.  The same base register within 32 bytes counts as the same line; a
# different base register, or an offset 32 or more away, does not.
---
name:            same_line
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1, $r12, $r14

    ; CHECK-LABEL: name: same_line
    ; CHECK:      STIDX64 killed $r1, $r0, 0
    ; CHECK-NEXT: $r12 = INCR
    ; CHECK-NEXT: $r14 = INCR
    ; CHECK-NEXT: $r13 = LDIDX64 killed $r0, 8
    ;
    ; OFF-LABEL: name: same_line
    ; OFF:      STIDX64 killed $r1, $r0, 0
    ; OFF-NEXT: $r13 = LDIDX64 killed $r0, 8
    STIDX64 $r1, $r0, 0 :: (store (s64))
    $r13 = LDIDX64 $r0, 8 :: (load (s64))
    $r12 = INCR killed $r12, implicit-def dead $flags
    $r14 = INCR killed $r14, implicit-def dead $flags
    RET_I
...
---
name:            other_line
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1, $r12, $r14

    ; CHECK-LABEL: name: other_line
    ; CHECK:      STIDX64 killed $r1, $r0, 0
    ; CHECK-NEXT: $r13 = LDIDX64 killed $r0, 32
    STIDX64 $r1, $r0, 0 :: (store (s64))
    $r13 = LDIDX64 $r0, 32 :: (load (s64))
    $r12 = INCR killed $r12, implicit-def dead $flags
    $r14 = INCR killed $r14, implicit-def dead $flags
    RET_I
...
---
name:            other_base
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r12, $r14

    ; CHECK-LABEL: name: other_base
    ; CHECK:      STIDX64 killed $r1, killed $r0, 0
    ; CHECK-NEXT: $r13 = LDIDX64 killed $r2, 8
    STIDX64 $r1, $r0, 0 :: (store (s64))
    $r13 = LDIDX64 $r2, 8 :: (load (s64))
    $r12 = INCR killed $r12, implicit-def dead $flags
    $r14 = INCR killed $r14, implicit-def dead $flags
    RET_I
...
