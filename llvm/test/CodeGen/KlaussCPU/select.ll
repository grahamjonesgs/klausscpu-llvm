; CHECK-NEXT:    jmp .LBB3_2
; CHECK-NEXT:  .LBB3_1:
; CHECK-NEXT:    setr r12, 200
; CHECK-NEXT:    jmp .LBB3_3
; CHECK-NEXT:  .LBB3_2:
; CHECK-NEXT:    setr r12, 100
; CHECK-NEXT:  .LBB3_3:
; CHECK-NEXT:    setsp r15
