; RUN: llc -march=klausscpu -O1 < %s | FileCheck %s

; SELECT expansion: no hardware CMOV — lowered to branch diamond + PHI.
; Each select becomes: CMPRV/CMPRR + JMPE + PHI.

define i64 @select_eq(i64 %cond, i64 %t, i64 %f) {
; CHECK-LABEL: select_eq:
; CHECK:       # %bb.0:
; CHECK-NEXT:    push r15
; CHECK-NEXT:    getsp r15
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    cmpeqr r12, r0, r12
; CHECK-NEXT:    cmprv r12, 0
; CHECK-NEXT:    jmpe .LBB0_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    copy r2, r1
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    copy r12, r2
; CHECK-NEXT:    setsp r15
; CHECK-NEXT:    pop r15
; CHECK-NEXT:    ret
  %c = icmp eq i64 %cond, 0
  %r = select i1 %c, i64 %t, i64 %f
  ret i64 %r
}

