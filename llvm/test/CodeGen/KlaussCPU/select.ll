; select with constant operands.
define i64 @select_const(i64 %cond) {
; CHECK-LABEL: select_const:
; CHECK:       # %bb.0:
; CHECK-NEXT:    push r15
; CHECK-NEXT:    getsp r15
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    cmpgtr r12, r0, r12
; CHECK-NEXT:    cmprv r12, 0
