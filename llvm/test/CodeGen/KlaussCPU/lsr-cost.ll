; Loop strength reduction ranks solutions by instruction count first
; (KlaussCPUTTIImpl::isLSRCostLess), knows the 15 allocatable GPRs and the
; addressing modes isel selects (KlaussCPUTargetLowering::
; isLegalAddressingMode: r + simm32, r + r, no scaled index).
; -klausscpu-lsr-insns-first=false (REGS) is the A/B switch back to the
; generic register-first order without dropping: one pointer IV per array.

; Four arrays indexed by one counter: one shared byte offset feeds the
; 1-word r + r LDIDX64R/STIDX64R, one ADDI per iteration instead of one per
; array (12 -> 9 instructions per iteration).
define void @add3(ptr %a, ptr %b, ptr %c, ptr %d, i64 %n) nounwind {
; CHECK-LABEL: add3:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    enter 0
; CHECK-NEXT:    ldidx64 r12, r15, 16
; CHECK-NEXT:    fbri r12, 1, 1, .LBB0_3
; CHECK-NEXT:  # %bb.1: # %for.body.preheader
; CHECK-NEXT:    setr r14, 0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_2: # %for.body
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldidx64r r13, r1, r14
; CHECK-NEXT:    ldidx64r r11, r2, r14
; CHECK-NEXT:    ldidx64r r10, r3, r14
; CHECK-NEXT:    decr r12, r12
; CHECK-NEXT:    addr r13, r11, r13
; CHECK-NEXT:    addr r13, r13, r10
; CHECK-NEXT:    stidx64r r13, r0, r14
; CHECK-NEXT:    addi r14, r14, 8
; CHECK-NEXT:    fbri r12, 0, 8, .LBB0_2
; CHECK-NEXT:  .LBB0_3: # %for.cond.cleanup
; CHECK-NEXT:    leaveret
;
; REGS-LABEL: add3:
; REGS:       # %bb.0: # %entry
; REGS-NEXT:    enter 0
; REGS-NEXT:    ldidx64 r12, r15, 16
; REGS-NEXT:    fbri r12, 1, 1, .LBB0_2
; REGS-NEXT:    .p2align 4
; REGS-NEXT:  .LBB0_1: # %for.body
; REGS-NEXT:    # =>This Inner Loop Header: Depth=1
; REGS-NEXT:    ldidx64 r14, r1, 0
; REGS-NEXT:    ldidx64 r13, r2, 0
; REGS-NEXT:    ldidx64 r11, r3, 0
; REGS-NEXT:    decr r12, r12
; REGS-NEXT:    addr r14, r13, r14
; REGS-NEXT:    addi r3, r3, 8
; REGS-NEXT:    addr r14, r14, r11
; REGS-NEXT:    addi r2, r2, 8
; REGS-NEXT:    stidx64 r14, r0, 0
; REGS-NEXT:    addi r0, r0, 8
; REGS-NEXT:    addi r1, r1, 8
; REGS-NEXT:    fbri r12, 0, 8, .LBB0_1
; REGS-NEXT:  .LBB0_2: # %for.cond.cleanup
; REGS-NEXT:    leaveret
entry:
  %cmp10 = icmp sgt i64 %n, 0
  br i1 %cmp10, label %for.body, label %for.cond.cleanup

for.cond.cleanup:
  ret void

for.body:
  %i = phi i64 [ %inc, %for.body ], [ 0, %entry ]
  %pb = getelementptr inbounds nuw [8 x i8], ptr %b, i64 %i
  %0 = load i64, ptr %pb, align 8
  %pc = getelementptr inbounds nuw [8 x i8], ptr %c, i64 %i
  %1 = load i64, ptr %pc, align 8
  %add = add nsw i64 %1, %0
  %pd = getelementptr inbounds nuw [8 x i8], ptr %d, i64 %i
  %2 = load i64, ptr %pd, align 8
  %add3 = add nsw i64 %add, %2
  %pa = getelementptr inbounds nuw [8 x i8], ptr %a, i64 %i
  store i64 %add3, ptr %pa, align 8
  %inc = add nuw nsw i64 %i, 1
  %exitcond.not = icmp eq i64 %inc, %n
  br i1 %exitcond.not, label %for.cond.cleanup, label %for.body
}

; The same for 32-bit elements (LDIDX32R/STIDX32R): 7 -> 6 instructions.
define void @scale32(ptr %a, ptr %b, i64 %n) nounwind {
; CHECK-LABEL: scale32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    fbri r2, 1, 1, .LBB1_3
; CHECK-NEXT:  # %bb.1: # %for.body.preheader
; CHECK-NEXT:    setr r12, 0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB1_2: # %for.body
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldidx32r r14, r1, r12
; CHECK-NEXT:    decr r2, r2
; CHECK-NEXT:    mulv r14, r14, 3
; CHECK-NEXT:    stidx32r r14, r0, r12
; CHECK-NEXT:    addi r12, r12, 4
; CHECK-NEXT:    fbri r2, 0, 8, .LBB1_2
; CHECK-NEXT:  .LBB1_3: # %for.cond.cleanup
; CHECK-NEXT:    ret
;
; REGS-LABEL: scale32:
; REGS:       # %bb.0: # %entry
; REGS-NEXT:    fbri r2, 1, 1, .LBB1_2
; REGS-NEXT:    .p2align 4
; REGS-NEXT:  .LBB1_1: # %for.body
; REGS-NEXT:    # =>This Inner Loop Header: Depth=1
; REGS-NEXT:    memget32 r12, r1
; REGS-NEXT:    decr r2, r2
; REGS-NEXT:    addi r1, r1, 4
; REGS-NEXT:    mulv r12, r12, 3
; REGS-NEXT:    memset32 r12, r0
; REGS-NEXT:    addi r0, r0, 4
; REGS-NEXT:    fbri r2, 0, 8, .LBB1_1
; REGS-NEXT:  .LBB1_2: # %for.cond.cleanup
; REGS-NEXT:    ret
entry:
  %cmp5 = icmp sgt i64 %n, 0
  br i1 %cmp5, label %for.body, label %for.cond.cleanup

for.cond.cleanup:
  ret void

for.body:
  %i = phi i64 [ %inc, %for.body ], [ 0, %entry ]
  %pb = getelementptr inbounds nuw [4 x i8], ptr %b, i64 %i
  %0 = load i32, ptr %pb, align 4
  %mul = mul nsw i32 %0, 3
  %pa = getelementptr inbounds nuw [4 x i8], ptr %a, i64 %i
  store i32 %mul, ptr %pa, align 4
  %inc = add nuw nsw i64 %i, 1
  %exitcond.not = icmp eq i64 %inc, %n
  br i1 %exitcond.not, label %for.cond.cleanup, label %for.body
}

; The counter also feeds a value used after the loop.  LSR's best solution
; here adds a second, down-counting IV for that value (one more instruction
; per iteration); it costs more than the loop as it is, so it is dropped
; (shouldDropLSRSolutionIfLessProfitable) and the loop keeps one IV.
@g_sink = global i64 0

define void @mix() nounwind {
; CHECK-LABEL: mix:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    setr64 r14, -1985229329, 19088743
; CHECK-NEXT:    setr64 r13, 1985229328, -19088744
; CHECK-NEXT:    setr r12, -1
; CHECK-NEXT:    setr r10, 499999
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB2_1: # %for.body
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    addr r14, r13, r14
; CHECK-NEXT:    shrv r9, r13, 3
; CHECK-NEXT:    shlv r11, r14, 7
; CHECK-NEXT:    incr r12, r12
; CHECK-NEXT:    xorr r14, r11, r14
; CHECK-NEXT:    subr r14, r14, r9
; CHECK-NEXT:    addr r13, r14, r13
; CHECK-NEXT:    shlv r11, r13, 11
; CHECK-NEXT:    xorr r13, r11, r13
; CHECK-NEXT:    addr r13, r13, r12
; CHECK-NEXT:    fbr r12, r10, 8, .LBB2_1
; CHECK-NEXT:  # %bb.2: # %for.cond.cleanup
; CHECK-NEXT:    addr r12, r13, r14
; CHECK-NEXT:    setru r13, g_sink
; CHECK-NEXT:    stidx64 r12, r13, 0
; CHECK-NEXT:    ret
;
; REGS-LABEL: mix:
; REGS:       # %bb.0: # %entry
; REGS-NEXT:    setr64 r13, -1985229329, 19088743
; REGS-NEXT:    setr64 r14, 1985229328, -19088744
; REGS-NEXT:    setr r12, 0
; REGS-NEXT:    setr r8, 500000
; REGS-NEXT:    .p2align 4
; REGS-NEXT:  .LBB2_1: # %for.body
; REGS-NEXT:    # =>This Inner Loop Header: Depth=1
; REGS-NEXT:    addr r13, r14, r13
; REGS-NEXT:    shrv r10, r14, 3
; REGS-NEXT:    shlv r11, r13, 7
; REGS-NEXT:    xorr r11, r11, r13
; REGS-NEXT:    subr r13, r11, r10
; REGS-NEXT:    addr r14, r13, r14
; REGS-NEXT:    shlv r9, r14, 11
; REGS-NEXT:    xorr r9, r9, r14
; REGS-NEXT:    addr r14, r12, r9
; REGS-NEXT:    incr r12, r12
; REGS-NEXT:    fbr r12, r8, 8, .LBB2_1
; REGS-NEXT:  # %bb.2: # %for.cond.cleanup
; REGS-NEXT:    addr r14, r9, r11
; REGS-NEXT:    subr r14, r14, r10
; REGS-NEXT:    addr r12, r14, r12
; REGS-NEXT:    setru r14, g_sink
; REGS-NEXT:    decr r12, r12
; REGS-NEXT:    stidx64 r12, r14, 0
; REGS-NEXT:    ret
entry:
  br label %for.body

for.cond.cleanup:
  %add5 = add i64 %add4, %sub
  store i64 %add5, ptr @g_sink, align 8
  ret void

for.body:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %for.body ]
  %b = phi i64 [ -81985529216486896, %entry ], [ %add4, %for.body ]
  %a = phi i64 [ 81985529216486895, %entry ], [ %sub, %for.body ]
  %add = add i64 %b, %a
  %shl = shl i64 %add, 7
  %xor = xor i64 %shl, %add
  %shr = lshr i64 %b, 3
  %sub = sub i64 %xor, %shr
  %add1 = add i64 %sub, %b
  %shl2 = shl i64 %add1, 11
  %xor3 = xor i64 %shl2, %add1
  %add4 = add i64 %xor3, %iv
  %iv.next = add nuw nsw i64 %iv, 1
  %exitcond.not = icmp eq i64 %iv.next, 500000
  br i1 %exitcond.not, label %for.cond.cleanup, label %for.body
}
