#ifndef ELF_RELOC
#error "ELF_RELOC must be defined before including this file"
#endif

ELF_RELOC(R_KLAUSSCPU_NONE,    0)
ELF_RELOC(R_KLAUSSCPU_ABS32,   1)  // 32-bit absolute, LE — instruction word-1 slot or 4-byte data ref
ELF_RELOC(R_KLAUSSCPU_ABS64,   2)  // 64-bit absolute, LE — 8-byte pointer field in .rodata/.data
