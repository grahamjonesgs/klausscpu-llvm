config ETH_KLAUSSCPU
	bool "KlaussCPU LiteEth Ethernet driver"
	default n
	depends on NET_L2_ETHERNET
	help
	  Ethernet driver for the KlaussCPU LiteEth MAC on Nexys A7.
	  Uses polled RX (no IRQ) and blocking TX via MMIO slot SRAM.

if ETH_KLAUSSCPU

config ETH_KLAUSSCPU_RX_STACK_SIZE
	int "RX polling thread stack size"
	default 4096

config ETH_KLAUSSCPU_RX_PRIO
	int "RX polling thread priority"
	default 2

config ETH_KLAUSSCPU_INIT_PRIORITY
	int "Init priority"
	default 80

config ETH_KLAUSSCPU_LOG_LEVEL
	int "Log level (0=OFF, 1=ERR, 2=WRN, 3=INF, 4=DBG)"
	default 3
	range 0 4

endif # ETH_KLAUSSCPU
