CONFIG_BOARD_NEXYS_A7=y
# XIP=n: the hardware ELF loader only handles PT_LOAD segments where
# VirtAddr == PhysAddr.  With XIP=y the .data section has VirtAddr=0x04000000
# but PhysAddr in the ROM segment (e.g. 0x1c2d0), so the loader silently
# ignores it and the data never reaches RAM — corrupting timeout_list and
# every other initialised global.  With XIP=n the linker collapses LMA into
# VMA so .data lives directly at 0x04000000 with VirtAddr==PhysAddr, and the
# loader places the content correctly.  __start's data-copy loop becomes a
# no-op (src==dst) but stays in for portability.
CONFIG_XIP=n
# Debug info + optimisation triggers a KlaussCPU backend crash (LLVM-23 dwarf issue).
# Disable until the backend DWARF emission is fixed.
CONFIG_DEBUG_INFO=n
CONFIG_SOC_KLAUSSCPU_NEXYS_A7=y
# Disable FP in printf — no soft-FP runtime for KlaussCPU yet.
CONFIG_CBPRINTF_FP_SUPPORT=n
CONFIG_CBPRINTF_FP_A_SUPPORT=n
CONFIG_UART_KLAUSSCPU=y
CONFIG_UART_CONSOLE=y
CONFIG_KLAUSSCPU_TIMER=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=100000000
