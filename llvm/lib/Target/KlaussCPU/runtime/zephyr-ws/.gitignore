# west workspace state — populated by `west init`/`west update`
.west/

# Zephyr upstream tree — fetched by `west update`, not part of our repo.
# Leading slash anchors at this dir only, so it does NOT match the
# klausscpu-zephyr/include/zephyr/ arch include namespace.
/zephyr/

# West-managed module trees (e.g. modules/fs/fatfs) — also fetched by
# `west update`, not part of our repo. modules/fs/fatfs was previously
# committed as a dangling submodule gitlink (no .gitmodules); it is now
# untracked and repopulated by west like /zephyr/ above.
/modules/

# Hardcoded build directories (any prefix variant)
build/
build_*/

# Editor / OS detritus
.DS_Store
*.swp
*~
