+
+/// Writes an object made by `create_object_file`.
+///
+/// KlaussCPU (the klausscpu-llvm fork): the `object` crate cannot write its
+/// ELF files, so `create_object_file` makes an ELF32 little-endian i386
+/// object, and this gives the written file KlaussCPU's `e_machine` and
+/// `e_flags`.  These objects never hold code or relocations, only data
+/// sections and symbols (metadata, and the undefined symbols that make the
+/// linker keep a dylib's exported code), so nothing else is i386-specific.
+pub(crate) fn write_object_file(sess: &Session, file: &write::Object<'_>) -> Vec<u8> {
+    let mut data = file.write().unwrap();
+    if sess.target.arch == Arch::KlaussCpu {
+        const EM_KLAUSSCPU: u16 = 0x4b43;
+        // The calling convention (ABI version 3) in the low byte, as the
+        // backend's own objects.
+        const EF_KLAUSSCPU_ABI3: u32 = 3;
+        assert_eq!(&data[..6], b"\x7fELF\x01\x01", "not an ELF32 little-endian file");
+        // Elf32_Ehdr: e_machine at offset 18, e_flags at offset 36.
+        data[18..20].copy_from_slice(&EM_KLAUSSCPU.to_le_bytes());
+        data[36..40].copy_from_slice(&EF_KLAUSSCPU_ABI3.to_le_bytes());
+    }
+    data
 }
 
