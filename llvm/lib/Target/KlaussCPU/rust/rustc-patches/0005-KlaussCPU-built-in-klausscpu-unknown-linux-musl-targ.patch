diff --git a/compiler/rustc_target/src/spec/targets/klausscpu_unknown_linux_musl.rs b/compiler/rustc_target/src/spec/targets/klausscpu_unknown_linux_musl.rs
new file mode 100644
index 000000000..f0e9d549a
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/klausscpu_unknown_linux_musl.rs
@@ -0,0 +1,44 @@
+// KlaussCPU Linux (klausscpu-llvm fork, llvm/lib/Target/KlaussCPU/ABI.md):
+// LP64 in ELFCLASS32 files, soft float, musl 1.2.5, LLVM's libunwind. The
+// linker is the fork's clang, which knows the triple and finds the musl
+// sysroot itself on the board (/opt/llvm); a cross build passes
+// `-Clink-arg=--sysroot=...`. The same target as the fork's
+// rust/klausscpu-unknown-linux-musl.json, built in so that it can be a host.
+
+use crate::spec::{
+    Arch, Cc, Env, LinkerFlavor, Lld, SplitDebuginfo, Target, TargetMetadata, TargetOptions, base,
+};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::linux::opts();
+    base.add_pre_link_args(
+        LinkerFlavor::Gnu(Cc::Yes, Lld::No),
+        &["--target=klausscpu-unknown-linux-musl"],
+    );
+
+    Target {
+        llvm_target: "klausscpu-unknown-linux-musl".into(),
+        metadata: TargetMetadata {
+            description: Some("KlaussCPU Linux (musl 1.2.5)".into()),
+            tier: Some(3),
+            host_tools: Some(true),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout: "e-m:e-p:64:64-i64:64-n32:64".into(),
+        arch: Arch::KlaussCpu,
+        options: TargetOptions {
+            env: Env::Musl,
+            linker: Some("clang".into()),
+            max_atomic_width: Some(64),
+            // musl's crt objects and libc come from the clang sysroot, not
+            // from rustc's self-contained directory.  A dylib or cdylib needs
+            // `-C target-feature=-crt-static` (as on the other musl targets):
+            // musl's libc.a is not PIC.
+            crt_static_default: true,
+            emit_debug_gdb_scripts: false,
+            supported_split_debuginfo: std::borrow::Cow::Borrowed(&[SplitDebuginfo::Off]),
+            ..base
+        },
+    }
+}
