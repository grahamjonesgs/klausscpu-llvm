From 1e8b91ca3f2f0a8d028847495fbcd01b6151bd90 Mon Sep 17 00:00:00 2001
From: Graham Jones <grahamjonesgs@gmail.com>
Date: Wed, 18 Nov 2026 13:32:35 +0200
Subject: [PATCH 1/2] KlaussCPU: the riscv64 modules (asm-generic, LP64),
 signed char

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/lib.rs | 48 +++++++++++++++++++++++++++---------------------
 1 file changed, 27 insertions(+), 21 deletions(-)

diff --git a/src/lib.rs b/src/lib.rs
index 18d40f9..e5c649c 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -6,6 +6,11 @@ While newer bindgen versions follow this convention, we support Rust 1.63 which
 this behavior. We can simply silence these warnings.
 */
 #![allow(unused_unsafe)]
+// KlaussCPU (the klausscpu-llvm fork) takes the riscv64 modules: its kernel
+// ABI is asm-generic and LP64 as riscv64's.  It differs in riscv64's own
+// additions (riscv_* system calls, hwprobe, ptrace and sigcontext registers,
+// ELF hwcaps), which rustc's use of rustix does not reach, and in `char`,
+// which is signed.
 
 #[cfg(feature = "std")]
 pub use std::os::raw as ctypes;
@@ -36,6 +41,7 @@ pub mod ctypes {
         target_arch = "x86",
         target_arch = "x86_64",
         target_arch = "xtensa",
+        target_arch = "klausscpu",
     ))]
     pub type c_char = c_schar;
 
@@ -1142,87 +1148,87 @@ pub mod system;
 #[path = "riscv32/xdp.rs"]
 pub mod xdp;
 #[cfg(feature = "auxvec")]
-#[cfg(target_arch = "riscv64")]
+#[cfg(any(target_arch = "riscv64", target_arch = "klausscpu"))]
 #[path = "riscv64/auxvec.rs"]
 pub mod auxvec;
 #[cfg(feature = "bootparam")]
-#[cfg(target_arch = "riscv64")]
+#[cfg(any(target_arch = "riscv64", target_arch = "klausscpu"))]
 #[path = "riscv64/bootparam.rs"]
 pub mod bootparam;
 #[cfg(feature = "btrfs")]
-#[cfg(target_arch = "riscv64")]
+#[cfg(any(target_arch = "riscv64", target_arch = "klausscpu"))]
 #[path = "riscv64/btrfs.rs"]
 pub mod btrfs;
 #[cfg(feature = "elf_uapi")]
-#[cfg(target_arch = "riscv64")]
+#[cfg(any(target_arch = "riscv64", target_arch = "klausscpu"))]
 #[path = "riscv64/elf_uapi.rs"]
 pub mod elf_uapi;
 #[cfg(feature = "errno")]
-#[cfg(target_arch = "riscv64")]
