# Copy to .klaussbuild.env (gitignored) and edit. Sourced by ./klauss-build.
# (Linux: .../build/x86_64-unknown-linux-gnu/stage1/bin/rustc)
export KLAUSSCPU_RUSTC="$HOME/Documents/src/klausscpu-rust/build/x86_64-apple-darwin/stage1/bin/rustc"
